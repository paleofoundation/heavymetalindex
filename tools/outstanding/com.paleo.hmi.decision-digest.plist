<?xml version="1.0" encoding="UTF-8"?>
<!-- Out-of-session decision-digest push. StartCalendarInterval (weekday mornings),
     NOT KeepAlive: fires once and exits. Runs a deterministic script that never
     calls a model — it only reads the ledger and posts a notification. This is the
     sanctioned scheduling shape (bounded, single-shot), the opposite of the
     KeepAlive/self-respawn pattern that produced the 2026-06-09 runaway.
     Enable: cp this file to ~/Library/LaunchAgents/ then
             launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.paleo.hmi.decision-digest.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.paleo.hmi.decision-digest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/karenpendergrass/Desktop/heavy-metal-index/tools/outstanding/decision-digest.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/tmp/hmi-decision-digest.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/hmi-decision-digest.err</string>
</dict>
</plist>
