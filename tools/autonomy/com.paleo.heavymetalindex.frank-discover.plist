<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    OPTIONAL decoupled discovery engine. The primary autonomous home for the
    discover-autopilot is a FRANK stage (frank.mjs runDiscover, every 18th cycle),
    so you do NOT need this job for autonomy. Load it only if you want multi-DB
    /discover to run on its own cadence independent of FRANK's cycle timing — e.g.
    a heavier overnight sweep, or to keep discovery running while FRANK is paused.

    Runs tools/autonomy/discover-autopilot.mjs every 3 hours, attending 2 open-gap
    page-groups per fire via the 10-database /discover skill (Sonnet, budgeted).
    launchd coalesces, so a still-running sweep is never doubled; the driver also
    holds ~/.discover-autopilot.lock as a second guard against overlap with the
    FRANK stage.

    Disable discovery (this job AND the FRANK stage) instantly:  touch ~/.discover.STOP
    Resume:                                                      rm ~/.discover.STOP

    Load (one command, immediately live, RunAtLoad fires one sweep now):
      launchctl bootstrap gui/$(id -u) \
        tools/autonomy/com.paleo.heavymetalindex.frank-discover.plist
    Unload:
      launchctl bootout gui/$(id -u)/com.paleo.heavymetalindex.frank-discover

    Isolated from FRANK and frank-codex — a discovery failure can never stall
    ingestion, and vice versa.
  -->
  <key>Label</key>
  <string>com.paleo.heavymetalindex.frank-discover</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/karenpendergrass/Desktop/heavy-metal-index/tools/autonomy/discover-autopilot.mjs</string>
    <string>--max-gaps=2</string>
    <string>--model=sonnet</string>
    <string>--timeout-mins=20</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/karenpendergrass/Desktop/heavy-metal-index</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HMI_REPO_ROOT</key>
    <string>/Users/karenpendergrass/Desktop/heavy-metal-index</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>10800</integer>

  <key>StandardOutPath</key>
  <string>/tmp/heavymetalindex-frank-discover.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/heavymetalindex-frank-discover.err.log</string>
</dict>
</plist>
