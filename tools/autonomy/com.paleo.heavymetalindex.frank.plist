<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    FRANK — the continuous, un-wedgeable ingest supervisor (tools/autonomy/frank.mjs).
    Replaces com.paleo.heavymetalindex.daemon (the monolithic bash tick that
    stalled for 12-18h at a time).

    FRANK is a PERSISTENT loop, not a one-shot tick. KeepAlive={SuccessfulExit:false}
    means: if FRANK crashes (non-zero exit) launchd restarts it; if it exits 0
    (because ~/.frank.STOP was set) launchd leaves it stopped. So `touch
    ~/.frank.STOP` actually halts it, and a crash self-heals. ThrottleInterval
    guards against a hot restart-loop if it ever crashes on boot.
  -->
  <key>Label</key>
  <string>com.paleo.heavymetalindex.frank</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/karenpendergrass/Desktop/heavy-metal-index/tools/autonomy/frank.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/karenpendergrass/Desktop/heavy-metal-index</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HMI_REPO_ROOT</key>
    <string>/Users/karenpendergrass/Desktop/heavy-metal-index</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>/tmp/heavymetalindex-frank.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/heavymetalindex-frank.err.log</string>
</dict>
</plist>
