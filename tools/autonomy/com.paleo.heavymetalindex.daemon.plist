<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.paleo.heavymetalindex.daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/Desktop/heavy-metal-index/tools/autonomy/daemon-tick.sh</string>
  </array>

  <!-- Every 30 minutes. Adjust to taste; the daemon is idempotent and exits
       cheaply when there's nothing to do. -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/heavymetalindex-daemon.out.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/heavymetalindex-daemon.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HMI_REPO_ROOT</key>
    <string>/Users/karenpendergrass/Desktop/heavy-metal-index</string>
  </dict>
</dict>
</plist>
