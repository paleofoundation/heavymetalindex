<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.paleo.heavymetalindex.daemon</string>

  <!--
    Invocation note (2026-05-14): launchd is configured to invoke /bin/bash
    directly with the script path as its first argument. The previous form
    (bash -lc "<path>") relied on bash to exec the script, which macOS blocks
    when the script carries a com.apple.provenance xattr (set on any file
    written by a sandboxed process like Claude Code). The current form
    reads the script and interprets it without exec'ing the file, bypassing
    the provenance check.

    If you still see "Operation not permitted" in /tmp/heavymetalindex-daemon.err.log:
      sudo xattr -cr ~/Desktop/heavy-metal-index/tools/autonomy/
      launchctl unload ~/Library/LaunchAgents/com.paleo.heavymetalindex.daemon.plist
      cp tools/autonomy/com.paleo.heavymetalindex.daemon.plist ~/Library/LaunchAgents/
      launchctl load ~/Library/LaunchAgents/com.paleo.heavymetalindex.daemon.plist
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/karenpendergrass/Desktop/heavy-metal-index/tools/autonomy/daemon-tick.sh</string>
  </array>

  <!-- 2026-05-28: switched from StartInterval=1800 to StartCalendarInterval
       at minute 0 and minute 30. Observed launchd silently missing fires
       under StartInterval when a previous tick ran longer than the interval
       (the 10:46Z tick took 1h44m and three subsequent 30-min fires never
       happened). StartCalendarInterval is wall-clock-anchored: launchd will
       fire at exactly :00 and :30 of every hour regardless of what the
       previous tick did. The PID lock in daemon-tick.sh prevents a
       still-running tick from being doubled up. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>0</integer></dict>
    <dict><key>Minute</key><integer>30</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/heavymetalindex-daemon.out.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/heavymetalindex-daemon.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HMI_REPO_ROOT</key>
    <string>/Users/karenpendergrass/Desktop/heavy-metal-index</string>
  </dict>
</dict>
</plist>
