<?xml version="1.0" encoding="UTF-8"?>
<!--
  FRANK v2 Phase 1 — governed, bounded, scheduled ingest.

  This is a TEMPLATE. It is NOT installed. Installing it is a deliberate act:
  Phase 1 does not run until you bootstrap this job. Do that only when you want
  to watch the first bounded runs (per docs/frank-v2-architecture.md Part 7).

  What it does vs. the retired FRANK:
    - StartInterval (hourly), NOT KeepAlive — the job runs once, exits, and is
      re-fired by the timer. There is NO keep-awake and NO self-respawn.
    - launchd will NOT start a second instance while one is still running, so
      runs are single-concurrency by construction.
    - The job is governed-run.mjs, which asks the Governor before spawning
      anything and exits on REFUSED. The daily/hourly/failure caps live in
      data/evidence/autonomy/governor-config.json.

  Kill switch:  touch ~/.frank.STOP   (every run refuses while it exists)

  INSTALL (only when you decide to turn it on):
    cp tools/autonomy/com.paleo.heavymetalindex.governed.plist.template \
       ~/Library/LaunchAgents/com.paleo.heavymetalindex.governed.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.paleo.heavymetalindex.governed.plist
    launchctl kickstart gui/$(id -u)/com.paleo.heavymetalindex.governed   # optional: run one batch now

  UNINSTALL (stop it):
    launchctl bootout gui/$(id -u)/com.paleo.heavymetalindex.governed
    rm ~/Library/LaunchAgents/com.paleo.heavymetalindex.governed.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.paleo.heavymetalindex.governed</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/karenpendergrass/Desktop/heavy-metal-index/tools/autonomy/governed-run.mjs</string>
    <string>--work=manual-fetch-ingest</string>
    <string>--max=10</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/karenpendergrass/Desktop/heavy-metal-index</string>

  <!-- Once per hour. The job runs and EXITS; the timer re-fires it. -->
  <key>StartInterval</key>
  <integer>3600</integer>

  <!-- Do NOT run at load: turning the job on is the timer's job, not load's. -->
  <key>RunAtLoad</key>
  <false/>

  <!-- Deliberately NO KeepAlive. KeepAlive is the always-on/self-respawn
       pattern that produced the 2026-06-09 runaway. Do not add it. -->

  <key>StandardOutPath</key>
  <string>/Users/karenpendergrass/Desktop/heavy-metal-index/data/evidence/autonomy/governed-run.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/karenpendergrass/Desktop/heavy-metal-index/data/evidence/autonomy/governed-run.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
