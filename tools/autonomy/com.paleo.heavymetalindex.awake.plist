<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.paleo.heavymetalindex.awake
  ================================
  Keeps the Mac mini awake 24/7 so the autonomy daemon's launchd timer
  (com.paleo.heavymetalindex.daemon, StartCalendarInterval at :00/:30)
  actually fires.

  WHY THIS EXISTS (root-cause, diagnosed 2026-05-29):
  macOS does NOT fire LaunchAgent StartCalendarInterval/StartInterval jobs
  while the machine is asleep. It coalesces every missed fire into a single
  catch-up run on the next full wake. The mini sleeps whenever Karen is away,
  so the "self-building" daemon went dark for 12-13 hours at a stretch (e.g.
  2026-05-29: last tick 10:20 local, next tick not until 23:08 on wake). The
  persistent `pmset` setting reads `sleep 0` but that is overridden by the
  real idle/maintenance-wake-then-sleep cycle once no app holds a wake
  assertion.

  `caffeinate -i -m -s` holds a power assertion that prevents idle system
  sleep (-i), disk idle sleep (-m), and system sleep on AC (-s). The mini is
  always on AC, so the assertion is always valid. KeepAlive respawns
  caffeinate if it ever dies; RunAtLoad starts it on login/reboot.

  This is the decisive fix for the recurring "silent death." The daemon's
  lock/trap hardening (commit-lock.sh, EXIT trap) handles the rest.

  INSTALL (one time):
    cp tools/autonomy/com.paleo.heavymetalindex.awake.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.paleo.heavymetalindex.awake.plist
    launchctl enable gui/$(id -u)/com.paleo.heavymetalindex.awake
  VERIFY:
    pgrep -lf caffeinate            # caffeinate process present
    pmset -g assertions | grep -i PreventUserIdleSystemSleep
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.paleo.heavymetalindex.awake</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>-m</string>
    <string>-s</string>
  </array>

  <!-- Start immediately on load and on every login/reboot. -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Respawn caffeinate if it ever exits, so the wake assertion is
       never silently dropped. This is the self-healing property the
       daemon scheduler depends on. -->
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/heavymetalindex-awake.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/heavymetalindex-awake.err.log</string>
</dict>
</plist>
