<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    FRANK origin-sync — pushes FRANK's committed work to origin every 15 min.
    Separate from the FRANK job on purpose: push is isolated from ingest, so a
    failed/slow push can never stall paper production. Push-only (see the script
    header). One-shot per fire; StartInterval reruns it.
  -->
  <key>Label</key>
  <string>com.paleo.heavymetalindex.frank-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/karenpendergrass/Desktop/heavy-metal-index/tools/autonomy/frank-sync.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/karenpendergrass/Desktop/heavy-metal-index</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HMI_REPO_ROOT</key>
    <string>/Users/karenpendergrass/Desktop/heavy-metal-index</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>900</integer>

  <key>StandardOutPath</key>
  <string>/tmp/heavymetalindex-frank-sync.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/heavymetalindex-frank-sync.err.log</string>
</dict>
</plist>
