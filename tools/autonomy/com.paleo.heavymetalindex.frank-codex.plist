<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    FRANK's second engine: Codex / ChatGPT-5.5 draining the auto-fetched stream.
    Runs tools/autonomy/ingest-with-codex.mjs (which spawns `codex exec` on
    Karen's ChatGPT Plus subscription — NO API billing) every 20 min. One sprint
    per fire, bounded to 18 min; launchd coalesces so a still-running sprint is
    never doubled.

    Partition: FRANK's Opus ingester runs with --exclude-roots=auto-fetched, so
    Opus owns the curated manual folders and Codex owns auto-fetched. The two
    engines never pick the same paper. Isolated from the FRANK job — a Codex
    failure can never stall Opus ingestion, and vice versa.
  -->
  <key>Label</key>
  <string>com.paleo.heavymetalindex.frank-codex</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/karenpendergrass/Desktop/heavy-metal-index/tools/autonomy/ingest-with-codex.mjs</string>
    <string>--timeout-mins=18</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/karenpendergrass/Desktop/heavy-metal-index</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HMI_REPO_ROOT</key>
    <string>/Users/karenpendergrass/Desktop/heavy-metal-index</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>

  <key>StartInterval</key>
  <integer>1200</integer>

  <key>StandardOutPath</key>
  <string>/tmp/heavymetalindex-frank-codex.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/heavymetalindex-frank-codex.err.log</string>
</dict>
</plist>
