#!/bin/bash
# Heavy Metal Fetch — double-clickable launcher for the local fetch-app.
# Hardened: node discovery under a Finder (login-shell-less) PATH, health-verified
# port reuse, cwd-locked server start, browser fallback chain, and osascript
# error surfacing. No Terminal is attached to a Finder launch, so every failure
# path ends in a dialog + a log line.

set -u

REPO="${HOME}/Desktop/heavy-metal-index"
SERVER_REL="tools/fetch-app/server.mjs"
PORT="8091"
HOST="127.0.0.1"
URL="http://${HOST}:${PORT}"
HEALTH_URL="${URL}/api/context"   # app-specific route; proves OUR server answers, not a squatter
LOG="${HOME}/Library/Logs/HeavyMetalFetch.log"

mkdir -p "$(dirname "$LOG")" 2>/dev/null
# Cap the log so it cannot grow without bound across launches.
if [ -f "$LOG" ] && [ "$(wc -c <"$LOG" 2>/dev/null || echo 0)" -gt 1048576 ]; then
  tail -c 262144 "$LOG" >"${LOG}.trim" 2>/dev/null && mv "${LOG}.trim" "$LOG" 2>/dev/null
fi
exec >>"$LOG" 2>&1
echo "===== launch $(date) ====="

# --- error dialog helper (Finder has no Terminal to print to) -------------
die() {
  # Escape backslashes and double-quotes so arbitrary messages cannot break the
  # AppleScript string. \n is intentionally left intact to render as a newline.
  local msg
  msg="$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
  /usr/bin/osascript -e "display dialog \"Heavy Metal Fetch could not start:\n\n${msg}\n\nLog: ${LOG}\" buttons {\"OK\"} default button \"OK\" with icon stop with title \"Heavy Metal Fetch\"" >/dev/null 2>&1
  echo "FATAL: $1"
  exit 1
}

# --- 1. discover a node binary --------------------------------------------
find_node() {
  local c candidates nvm_node inherited shell_node
  candidates=(
    "$HOME/.local/bin/node"
    "/opt/homebrew/bin/node"
    "/usr/local/bin/node"
  )
  for c in "${candidates[@]}"; do
    # -x AND actually runnable (guards a broken symlink or a non-node file)
    if [ -x "$c" ] && "$c" -v >/dev/null 2>&1; then echo "$c"; return 0; fi
  done
  # newest nvm-installed node, if any (glob may not match; 2>/dev/null swallows it)
  nvm_node="$(ls -1d "$HOME/.nvm/versions/node/"*/bin/node 2>/dev/null | sort -V | tail -1)"
  if [ -n "$nvm_node" ] && [ -x "$nvm_node" ] && "$nvm_node" -v >/dev/null 2>&1; then
    echo "$nvm_node"; return 0
  fi
  # anything already on the inherited PATH
  inherited="$(command -v node 2>/dev/null)"
  if [ -n "$inherited" ] && "$inherited" -v >/dev/null 2>&1; then echo "$inherited"; return 0; fi
  # last resort: ask the user's login shell to resolve it (nvm/asdf shims)
  shell_node="$("${SHELL:-/bin/zsh}" -lic 'command -v node' 2>/dev/null | tail -1)"
  if [ -n "$shell_node" ] && [ -x "$shell_node" ] && "$shell_node" -v >/dev/null 2>&1; then
    echo "$shell_node"; return 0
  fi
  return 1
}

NODE="$(find_node)"
[ -z "$NODE" ] && die "Node.js was not found. Install it from https://nodejs.org and try again."
echo "node: $NODE ($("$NODE" -v 2>/dev/null))"

# --- 2. sanity-check the repo ---------------------------------------------
[ -d "$REPO" ] || die "The Heavy Metal Index folder was not found at:\n$REPO\n\nIf you moved or renamed it, put it back on the Desktop with that exact name."
[ -f "$REPO/$SERVER_REL" ] || die "Server file not found at:\n$REPO/$SERVER_REL\n\nThe app folder may be incomplete."

# --- 3. is OUR server already answering? (idempotent double-click) --------
# Use the app-specific /api/context route and require HTTP 200, so an unrelated
# process squatting on 8091 does NOT look like a healthy fetch-app.
our_server_up() {
  local code
  code="$(/usr/bin/curl -s -o /dev/null -w '%{http_code}' --max-time 2 "$HEALTH_URL" 2>/dev/null)"
  [ "$code" = "200" ]
}
# Anything at all listening on the port (may be a foreign process).
port_bound() {
  /usr/bin/curl -s -o /dev/null --max-time 2 "$URL" >/dev/null 2>&1
}

if our_server_up; then
  echo "fetch-app already running on $PORT — reusing it"
else
  if port_bound; then
    die "Port $PORT is already being used by another program, and it is not Heavy Metal Fetch.\n\nQuit whatever is using port $PORT (or restart the Mac) and try again."
  fi
  echo "starting server..."
  # The server derives its repo root from the current directory (process.cwd()),
  # so it MUST be launched from inside the repo or downloads land in the wrong place.
  cd "$REPO" || die "Could not enter the repo folder:\n$REPO"
  HMI_FETCH_APP_PORT="$PORT" HMI_FETCH_APP_HOST="$HOST" \
    nohup "$NODE" "$REPO/$SERVER_REL" >>"$LOG" 2>&1 &
  SERVER_PID=$!
  disown 2>/dev/null || true

  # wait up to ~15s for OUR server to answer 200
  up=0
  for _ in $(seq 1 30); do
    if our_server_up; then up=1; break; fi
    # if the node process already died, stop waiting and report immediately
    if ! kill -0 "$SERVER_PID" 2>/dev/null; then break; fi
    sleep 0.5
  done
  if [ "$up" != "1" ]; then
    die "The server did not start listening on port $PORT.\nOpen the log for details:\n$LOG"
  fi
  echo "server is up (pid $SERVER_PID)"
fi

# --- 4. open the UI in an app-mode window ---------------------------------
CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
EDGE="/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge"
BRAVE="/Applications/Brave Browser.app/Contents/MacOS/Brave Browser"
PROFILE="${HOME}/Library/Application Support/HeavyMetalFetch/browser-profile"
mkdir -p "$PROFILE" 2>/dev/null

open_app_mode() {
  local bin="$1"
  "$bin" --app="$URL" --user-data-dir="$PROFILE" \
    --no-first-run --no-default-browser-check >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

if [ -x "$CHROME" ]; then
  echo "opening in Chrome app-mode"; open_app_mode "$CHROME"
elif [ -x "$EDGE" ]; then
  echo "opening in Edge app-mode"; open_app_mode "$EDGE"
elif [ -x "$BRAVE" ]; then
  echo "opening in Brave app-mode"; open_app_mode "$BRAVE"
else
  echo "no Chromium browser — falling back to default browser"
  # If even this fails (no default browser), tell the user the URL explicitly.
  if ! /usr/bin/open "$URL" 2>/dev/null; then
    die "Could not open a browser automatically.\n\nOpen this address yourself:\n$URL"
  fi
fi

echo "launch complete"
exit 0
