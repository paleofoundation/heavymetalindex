# Pre-commit hook per CLAUDE.md Part 5b.
#
# When a commit touches wiki/sources/, refresh the routing audit and abort
# the commit if the audit cannot regenerate cleanly (blocking-malformed
# entries; missing cite_key on a source page). The audit's sibling logs
# (routing_unresolved.csv, routing_malformed.csv) catch advisory and strict
# issues without blocking the commit during the migration period.
#
# Skips the audit when no wiki/sources/ files are staged so commits to
# unrelated paths stay fast.

if git diff --cached --name-only | grep -q '^wiki/sources/'; then
  echo "pre-commit: wiki/sources/ touched; running routing audit..."
  if ! npm run --silent evidence:source-routes; then
    echo "pre-commit: routing audit failed. Fix the blocking-malformed source(s) named above (typically missing cite_key) and re-commit."
    exit 1
  fi

  # If the audit regenerated the audit CSVs, stage them so the commit
  # includes the refreshed state instead of leaving it as a dirty working
  # tree post-commit.
  for f in data/evidence/product_source_routing_audit.csv data/evidence/routing_unresolved.csv data/evidence/routing_malformed.csv; do
    if [ -f "$f" ] && ! git diff --quiet -- "$f"; then
      git add "$f"
    fi
  done

  # DOI completeness check. Catches the 2026-05-12 night-ingest failure mode
  # at commit time instead of at the next build's prebuild audit. A source
  # page passes if doi has a non-null value, OR no_doi_assigned: true is set
  # (declared no-DOI venue), OR source_type is textbook-chapter.
  doi_bad=0
  for f in $(git diff --cached --name-only --diff-filter=AM | grep '^wiki/sources/.*\.md$'); do
    head -40 "$f" > /tmp/.husky-fm.$$
    doi_line=$(grep -E '^doi:' /tmp/.husky-fm.$$ | head -1 | sed -E 's/^doi:[[:space:]]*//;s/^"//;s/"$//')
    no_doi_assigned=$(grep -cE '^no_doi_assigned:[[:space:]]*true' /tmp/.husky-fm.$$ || true)
    src_type=$(grep -E '^source_type:' /tmp/.husky-fm.$$ | head -1 | sed -E 's/^source_type:[[:space:]]*//;s/^"//;s/"$//')
    is_missing=0
    case "$doi_line" in
      ""|null|unknown) is_missing=1 ;;
    esac
    if [ "$is_missing" = "1" ] && [ "$no_doi_assigned" = "0" ] && [ "$src_type" != "textbook-chapter" ]; then
      echo "pre-commit: $f has doi: '$doi_line' and no no_doi_assigned: true marker."
      doi_bad=$((doi_bad + 1))
    fi
    rm -f /tmp/.husky-fm.$$
  done
  if [ "$doi_bad" -gt 0 ]; then
    echo "pre-commit: $doi_bad staged source page(s) have missing DOI metadata."
    echo "Either fill in doi (preferred) or add no_doi_assigned: true with a real publisher access_url."
    echo "See wiki/lint/2026-05-13-doi-fallback-followup.md for context."
    exit 1
  fi
fi
