.DS_Store
*.swp
*.swo

# raw/ contains the immutable source-document PDFs. Content is gitignored
# (too large, and includes copyright-licensed material that must not be
# redistributed). raw/README.md is committed and documents the provenance
# model and auditor access process.
raw/*
!raw/README.md
!raw/*/INGESTED.md
!raw/manifest/
!raw/manifest/**
# raw/manual-fetch/ is the staging area for materials Karen drops in
# response to a wishlist gap. README + wishlist are committed; dropped
# files stay local until ingest routes them into raw/studies/ etc.
!raw/manual-fetch/
raw/manual-fetch/**/*
!raw/manual-fetch/**/
!raw/manual-fetch/**/README.md
!raw/manual-fetch/**/wishlist.md

# raw/gpt-drafts/ is the dropoff for GPT-5.5 fast-mode source-page first
# drafts. Drafts themselves are unverified and gitignored; only the README
# is committed. See docs/gpt-collaboration/README.md.
!raw/gpt-drafts/
raw/gpt-drafts/**/*
!raw/gpt-drafts/README.md

# Quartz / Node build artifacts
node_modules
public/
!tools/standards-workbench/public/
!tools/standards-workbench/public/**
.quartz-cache/
prof/
tsconfig.tsbuildinfo

# Continuous gap-fill runtime — local SQLite queue + processed-keys store.
# Per-machine, regenerated by `node tools/runtime/run-loop.mjs`.
data/runtime/

.replit
replit.nix
.obsidian/
.vercel
.env*.local
# Project-local Claude Code config — gitignored except for skills, which
# ship with the project so all sessions (Claude Code, Cowork, future
# instances on any machine) can use them.
.claude/*
!.claude/skills/
!.claude/skills/**
# Local PDF extraction packets/prompts may contain copyrighted source text.
# Keep them local and commit only structured evidence, queues, audits, and gap reports.
data/evidence/local_reingest_packets/
data/evidence/local_reingest_prompts/

# Autonomy daemon per-tick logs (local only)
data/evidence/autonomy/daemon-runs/

# Daemon heartbeat — written every tick; tracking it self-blocks the daemon
data/evidence/autonomy/heartbeat.txt
.env.development

# HMTc commercial/marketing — private nested repo; never tracked or published by the wiki repo
hmtc-commercial/

# FRANK supervisor heartbeat + log (local liveness, not corpus state)
data/evidence/autonomy/FRANK-status.md
data/evidence/autonomy/frank.log
data/evidence/autonomy/frank-sync.log
data/evidence/autonomy/frank-codex.heartbeat
data/evidence/autonomy/frank-intake-done.txt
# Engine lock files (runtime mutex, not corpus state)
data/evidence/autonomy/*.lock
# FRANK control sentinels (local halt switches, not corpus state)
.FRANK.STOP
.FRANK.PAUSE
data/evidence/gems-aggregates.jsonl
.env*
