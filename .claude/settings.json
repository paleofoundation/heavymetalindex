{
  "//": "Shared project hooks for the outstanding-items ledger. Both hooks are DETERMINISTIC (no model call). See docs/outstanding-ledger.md and CLAUDE.md Part 28.",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/outstanding/stop-hook-capture.mjs"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node tools/outstanding/surface-decisions.mjs"
          }
        ]
      }
    ]
  }
}
