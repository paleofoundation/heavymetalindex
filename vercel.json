{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "installCommand": "npm install",
  "framework": null,
  "git": {
    "deploymentEnabled": false
  },
  "cleanUrls": true,
  "functions": {
    "api/ask.js": {
      "maxDuration": 30,
      "excludeFiles": "{.claude,.vercel}/**"
    },
    "api/contamination.mjs": {
      "maxDuration": 15,
      "excludeFiles": "{.claude,.vercel}/**"
    },
    "api/regulations.mjs": {
      "maxDuration": 15,
      "excludeFiles": "{.claude,.vercel}/**"
    },
    "api/evidence-packet.mjs": {
      "maxDuration": 15,
      "excludeFiles": "{.claude,.vercel}/**"
    },
    "api/defense-dossier.mjs": {
      "maxDuration": 15,
      "excludeFiles": "{.claude,.vercel}/**"
    },
    "api/change-watch.mjs": {
      "maxDuration": 15,
      "excludeFiles": "{.claude,.vercel}/**"
    },
    "api/risk-map.mjs": {
      "maxDuration": 15,
      "excludeFiles": "{.claude,.vercel}/**"
    },
    "api/corrections.mjs": {
      "maxDuration": 15,
      "excludeFiles": "{.claude,.vercel}/**"
    },
    "api/mcp.mjs": {
      "maxDuration": 30,
      "excludeFiles": "{.claude,.vercel}/**"
    },
    "api/queue/discovery.mjs": {
      "maxDuration": 300,
      "excludeFiles": "{data,.claude,.vercel}/**"
    },
    "api/queue/extraction.mjs": {
      "maxDuration": 300,
      "excludeFiles": "{data,.claude,.vercel}/**"
    },
    "api/queue/routing.mjs": {
      "maxDuration": 300,
      "excludeFiles": "{data,.claude,.vercel}/**"
    },
    "api/queue/dead-letter.mjs": {
      "maxDuration": 30,
      "excludeFiles": "{data,.claude,.vercel}/**"
    },
    "api/cron/enqueue-discovery.mjs": {
      "maxDuration": 60,
      "excludeFiles": "{data/evidence,.claude,.vercel}/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/enqueue-discovery",
      "schedule": "0 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" },
        { "key": "Content-Type", "value": "application/xml" }
      ]
    },
    {
      "source": "/sitemap-scholarly.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" },
        { "key": "Content-Type", "value": "application/xml" }
      ]
    },
    {
      "source": "/static/contamination.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=300, stale-while-revalidate=600" },
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    }
  ]
}
