  "design": "method validation with application to market vegetables",
  "origin": "not stated",
  "market": "Hua Takhe fresh market, Bangkok, Thailand",
  "period_text": "January to July 2554 B.E. (2011)",
  "method": "differential pulse anodic stripping voltammetry with standard addition after H2SO4/H2O2 wet digestion of oven-dried (70 C) powder; results back-calculated to fresh weight",
