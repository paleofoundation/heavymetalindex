 "disposition": "occurrence_extracted",
 "disposition_reason": "Seventy-eight retail chocolate samples from nine producing countries bought on the Chinese market were measured for cadmium by solid sampling ETV-AAS; Table 1 gives per-country minimum, maximum, mean, SD and median.",
 "disposition_locator": "Table 1, p. 6; Section 2.6, p. 7",
 "study": {
  "design": "Analytical method development (solid sampling ETV-AAS) with application to a market survey of chocolate",
  "origin": "9 producing countries (China, United States, Italy, Germany, Japan, Switzerland, France, Russia, Malaysia per Results; Methods list New Zealand instead of France)",
  "market": "Chinese market (shops not specified)",
  "period_text": "",
  "method": "Solid sampling electrothermal vaporization AAS with MgO-filled catalytic pyrolysis furnace, no digestion; cross-checked against microwave digestion GF-AAS",
  "lod_text": "Cd method LOD 70 pg/g (0.07 µg/kg) using a 0.1 g sample",
  "basis": "as_sold",
  "qa": "Peanut powder CRM GBW(E)100718 (certified Cd 62 ± 3 ng/g), RSD 3.2% (n = 11); chocolate RSDs 1.5-6.4%; recoveries 93-107%; no significant difference from GF-AAS (R2 = 0.9953)",
  "site_context": "market"
 },
