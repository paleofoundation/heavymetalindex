 "disposition_reason": "Nationally representative retail composites of soybean and palm oil from Bangladesh were analysed for arsenic, cadmium, chromium, lead and mercury, with average and range printed per oil type in Table 2; refinery crude and refined oil mercury means are printed in the Results text.",
 "disposition_locator": "Table 2, p. 5; Results text, p. 4",
 "study": {
  "design": "Nationwide retail market survey; national composites per brand (at least 12 samples each) and per-division composites of unbranded oil; plus individual refinery crude and refined samples for mercury",
  "origin": "Oils refined in Bangladesh largely from imported crude oil (as stated in Discussion)",
  "market": "Grocery shops in 70 clusters (29 urban, 41 rural) in 23 districts across all eight administrative divisions of Bangladesh; five refineries for crude and refined samples",
  "period": {
   "from": 2021,
   "to": 2021,
   "as_reported": "Two rounds: February-March 2021 and June-August 2021"
  },
  "method": "Microwave digestion (HNO3/H2O2); graphite furnace AAS for Cd, Cr, Pb; hydride generation AAS for As; cold-vapor AAS for Hg (Shimadzu AA-7000)",
  "lod": [
   "LOD 0.36 ug As/L, 0.015 ug Cd/L, 0.19 ug Cr/L, 0.16 ug Pb/L, 0.1 ug Hg/L; LOQ 1.00 ug As/L, 0.50 ug Cd/L, 0.50 ug Cr/L, 1.00 ug Pb/L, 0.3 ug Hg/L (solution basis)"
  ],
  "basis": "as_sold",
  "qa": "NIST SRM 1568b rice flour and SRM 1849a infant/adult nutritional formula used for recovery during validation (no oil reference material available); recoveries in Supplemental Tables S1-S2 (not in the PDF); spikes, blanks and mid-range calibration checks",
  "site_context": "market"
 },
