  "period": {
   "from": 2024,
   "to": 2025,
   "as_reported": "April 2024 to May 2025"
  },
  "method": "dry ashing with MgO/Mg(NO3)2, arsine generation with Zn/KI, silver diethyldithiocarbamate spectrophotometry; 2.5 g sample",
  "lod": [
   "not determined in the study; cites LQ of 0.1-0.2 µg/g for the method from the literature"
  ],
  "basis": "as_sold",
  "qa": "duplicate determinations, daily calibration curves (R2 0.9963-1.0); no CRM or spike recovery performed (literature recoveries 85-102% cited)",
  "site_context": "market"
