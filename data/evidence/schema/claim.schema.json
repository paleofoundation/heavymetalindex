{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heavymetalindex.com/schema/evidence/claim.schema.json",
  "title": "Heavy Metal Index Claim Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_id", "claim_class", "review_state", "claim_text", "source_id", "quote_trace"],
  "properties": {
    "claim_id": { "type": "string", "minLength": 1 },
    "claim_class": {
      "enum": [
        "literature_finding",
        "regulatory_limit",
        "toxicology_reference_value",
        "exposure_model",
        "internal_standard_candidate",
        "hmtc_threshold",
        "public_wiki_claim",
        "app_model_assumption"
      ]
    },
    "claim_text": { "type": "string", "minLength": 1 },
    "source_id": { "type": "string", "minLength": 1 },
    "value_id": { "type": ["string", "null"] },
    "quote_trace": { "type": "string", "minLength": 1 },
    "page_number": { "type": ["string", "null"] },
    "review_state": {
      "enum": [
        "draft",
        "machine_extracted",
        "needs_review",
        "reviewed",
        "approved_for_internal",
        "approved_for_public",
        "published",
        "rejected",
        "superseded",
        "needs_source",
        "needs_unit_review",
        "needs_legal_review"
      ]
    },
    "public_label": {
      "enum": [
        "Strong occurrence evidence",
        "Reconstructable dataset",
        "Modeled or limited evidence",
        "Context only",
        "Data gap",
        "Rejected/unusable",
        null
      ]
    },
    "sampling_country": {
      "type": ["string", "null"],
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2 country where the sample was taken. Omit when the source does not state a sampling country. Not an author affiliation and not the source-page jurisdictions array."
    },
    "sampling_region": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "Admin-1 name as printed (state, province, prefecture, governorate). Omit when no admin-1 name is printed."
    },
    "lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
    "lon": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
    "sampling_year_start": { "type": ["integer", "null"], "minimum": 1900, "maximum": 2100 },
    "sampling_year_end": { "type": ["integer", "null"], "minimum": 1900, "maximum": 2100 },
    "harvest_year": { "type": ["integer", "null"], "minimum": 1900, "maximum": 2100 },
    "practice": {
      "enum": [
        "flooded",
        "awd",
        "upland",
        "organic",
        "conventional",
        "wastewater_irrigated",
        "sludge_amended",
        "mining_proximate",
        "smelter_proximate",
        "volcanic_soil",
        "geogenic_as_groundwater",
        "post_harvest_processing",
        "unknown",
        null
      ]
    },
    "geo_precision": {
      "enum": ["point", "admin2", "admin1", "country", "multi_country", "unknown", null]
    },
    "geo_source": { "type": ["string", "null"], "minLength": 1 },
    "geo_provenance": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
