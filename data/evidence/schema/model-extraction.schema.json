{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heavymetalindex.com/schema/evidence/model-extraction.schema.json",
  "title": "Heavy Metal Index — Per-Model Extraction Row",
  "description": "One row per (candidate, model_slug, prompt_version). Two rows per ranked candidate (one per provider). Written by tools/extract/dual-model-extractor.ts. The disagreement detector (HMI-9.9) compares paired rows axis by axis.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extraction_id",
    "candidate_id",
    "model_slug",
    "model_version",
    "prompt_version",
    "verdict",
    "findings",
    "response",
    "started_at",
    "finished_at",
    "duration_ms",
    "usage"
  ],
  "properties": {
    "extraction_id": {
      "type": "string",
      "minLength": 1,
      "description": "sha256(candidate_id + ':' + model_slug + ':' + prompt_version), hex. Idempotency key for the writer."
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "description": "Matches DiscoveryCandidate.candidate_id."
    },
    "model_slug": {
      "type": "string",
      "minLength": 1,
      "description": "AI Gateway provider string the request was sent under (e.g. anthropic/claude-opus-4-7, openai/gpt-5.1). The wire-time slug for the dual-model-extractor role."
    },
    "model_version": {
      "type": "string",
      "minLength": 1,
      "description": "Concrete model version returned by the provider. Falls back to model_slug when the gateway does not return a distinct version."
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1,
      "description": "Semver-ish identifier of the extraction prompt template (e.g. extract.v1)."
    },
    "verdict": {
      "enum": ["extracted", "no_finding", "unfit_source"],
      "description": "Model's top-level verdict. 'no_finding' is valid and expected for off-topic candidates."
    },
    "findings": {
      "type": "array",
      "description": "Per-row structured findings. Empty when verdict is 'no_finding' or 'unfit_source'. Each finding mirrors value.schema.json field shape, minus the assigned value_id and source_id which the audit barrier (HMI-12) fills in.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_class",
          "quote_trace",
          "evidence_fitness_verdict",
          "public_label"
        ],
        "properties": {
          "claim_class": {
            "enum": [
              "literature_finding",
              "regulatory_limit",
              "toxicology_reference_value",
              "exposure_model"
            ]
          },
          "metal_species": { "type": ["string", "null"] },
          "product_matrix": { "type": ["string", "null"] },
          "basis": {
            "enum": [
              "wet_weight",
              "dry_weight",
              "as_sold",
              "prepared_for_feeding",
              "as_consumed",
              "reconstituted",
              "not_reported",
              null
            ]
          },
          "statistic_type": { "type": ["string", "null"] },
          "original_value": { "type": ["number", "null"] },
          "original_unit": { "type": ["string", "null"] },
          "normalized_value": { "type": ["number", "null"] },
          "normalized_unit": { "type": ["string", "null"] },
          "quote_trace": { "type": "string", "minLength": 1 },
          "page_number": { "type": ["string", "null"] },
          "table_number": { "type": ["string", "null"] },
          "evidence_fitness_verdict": {
            "enum": ["EF-1", "EF-2", "EF-3", "EF-4", "EF-5", "EF-X"]
          },
          "public_label": {
            "enum": [
              "Strong occurrence evidence",
              "Reconstructable dataset",
              "Modeled or limited evidence",
              "Context only",
              "Data gap",
              "Rejected/unusable"
            ]
          },
          "sampling_country": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" },
          "sampling_region": { "type": ["string", "null"], "minLength": 1 },
          "lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
          "lon": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
          "sampling_year_start": { "type": ["integer", "null"], "minimum": 1900, "maximum": 2100 },
          "sampling_year_end": { "type": ["integer", "null"], "minimum": 1900, "maximum": 2100 },
          "harvest_year": { "type": ["integer", "null"], "minimum": 1900, "maximum": 2100 },
          "practice": {
            "enum": [
              "flooded",
              "awd",
              "upland",
              "organic",
              "conventional",
              "wastewater_irrigated",
              "sludge_amended",
              "mining_proximate",
              "smelter_proximate",
              "volcanic_soil",
              "geogenic_as_groundwater",
              "post_harvest_processing",
              "unknown",
              null
            ]
          },
          "geo_precision": {
            "enum": ["point", "admin2", "admin1", "country", "multi_country", "unknown", null]
          },
          "geo_source": { "type": ["string", "null"], "minLength": 1 },
          "geo_provenance": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    "notes": {
      "type": ["string", "null"],
      "description": "Short reviewer notes the model may attach. Not propagated downstream; kept for the audit trail."
    },
    "response": {
      "description": "Raw model response body, preserved verbatim for audit. Object when the provider returns parseable JSON; otherwise a string carrier with the raw text.",
      "type": ["object", "string"]
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp when the AI Gateway request started."
    },
    "finished_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp when the response finished."
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Wall-clock duration for this provider's call."
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "description": "Token + cost accounting from the gateway. Used for the dual-model-extractor cap calibration at day 30.",
      "properties": {
        "input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "total_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "error": {
      "description": "Set when the call failed at the provider or gateway layer. The row is still written so the worker layer can retry and the audit trail records the attempt.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["gateway_http", "gateway_parse", "schema_validation", "transport", "timeout"]
        },
        "message": { "type": "string" },
        "http_status": { "type": ["integer", "null"] }
      }
    }
  }
}
