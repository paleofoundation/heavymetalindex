{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "family": {
      "type": "string",
      "enum": [
        "metal",
        "ingredient",
        "product"
      ]
    },
    "page_slug": {
      "type": "string",
      "minLength": 1
    },
    "coverage_state": {
      "type": "string",
      "enum": [
        "partial",
        "complete"
      ]
    },
    "answers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question_id": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "object",
            "properties": {
              "analytes": {
                "type": "string",
                "minLength": 1
              },
              "material_form": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "type": "string",
                "minLength": 1
              },
              "geography_market": {
                "type": "string",
                "minLength": 1
              },
              "period": {
                "type": "string",
                "minLength": 1
              },
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "population_route": {
                "type": "string",
                "minLength": 1
              },
              "comparator_outcome": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "analytes",
              "material_form",
              "basis",
              "geography_market",
              "period",
              "stage",
              "population_route",
              "comparator_outcome"
            ],
            "additionalProperties": false
          },
          "workflow_state": {
            "type": "string",
            "enum": [
              "unassessed",
              "searching",
              "access_blocked",
              "extracting",
              "assessing",
              "reviewed",
              "stale"
            ]
          },
          "evidence_state": {
            "type": "string",
            "enum": [
              "not_assessed",
              "available",
              "conflicting",
              "insufficient",
              "no_eligible_evidence",
              "inaccessible",
              "not_applicable"
            ]
          },
          "answer": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "search": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "not_started",
                  "in_progress",
                  "complete",
                  "access_blocked",
                  "not_applicable"
                ]
              },
              "scope": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "protocol_ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "record_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "screening_ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "searched_through": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "unresolved_access": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "status",
              "scope",
              "protocol_ref",
              "record_refs",
              "screening_ref",
              "searched_through",
              "limitations",
              "unresolved_access"
            ],
            "additionalProperties": false
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "synthesis_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "applicability": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "limits_of_inference": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "certainty": {
            "type": "object",
            "properties": {
              "judgment": {
                "type": "string",
                "enum": [
                  "high",
                  "moderate",
                  "low",
                  "very_low",
                  "not_assessed",
                  "not_applicable"
                ]
              },
              "method": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "assessment_ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "rationale": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "judgment",
              "method",
              "assessment_ref",
              "rationale"
            ],
            "additionalProperties": false
          },
          "review": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "ai",
                      "human",
                      "combined"
                    ]
                  },
                  "reviewer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "date": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  "record_ref": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "reviewer",
                  "date",
                  "record_ref"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "not_applicable_reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "supersedes": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "dependent_pages": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "question_id",
          "scope",
          "workflow_state",
          "evidence_state",
          "answer",
          "search",
          "evidence_refs",
          "synthesis_refs",
          "applicability",
          "limits_of_inference",
          "certainty",
          "review",
          "not_applicable_reason",
          "revision",
          "supersedes",
          "dependent_pages"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "workflow_state": {
                  "const": "reviewed"
                }
              },
              "required": [
                "workflow_state"
              ]
            },
            "then": {
              "properties": {
                "answer": {
                  "type": "string",
                  "minLength": 1
                },
                "applicability": {
                  "type": "string",
                  "minLength": 1
                },
                "limits_of_inference": {
                  "type": "string",
                  "minLength": 1
                },
                "review": {
                  "type": "object"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "evidence_state": {
                  "const": "no_eligible_evidence"
                }
              },
              "required": [
                "evidence_state"
              ]
            },
            "then": {
              "properties": {
                "evidence_refs": {
                  "maxItems": 0
                },
                "search": {
                  "properties": {
                    "status": {
                      "const": "complete"
                    },
                    "unresolved_access": {
                      "maxItems": 0
                    },
                    "record_refs": {
                      "minItems": 1
                    },
                    "protocol_ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "screening_ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "searched_through": {
                      "type": "string",
                      "format": "date"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "contract_version",
    "family",
    "page_slug",
    "coverage_state",
    "answers"
  ],
  "additionalProperties": false,
  "title": "HMI page-question record v1.0.0",
  "description": "Structural schema. tools/contracts/validate.mjs additionally enforces register membership, search-gap, review, applicability, certainty and completeness invariants."
}
