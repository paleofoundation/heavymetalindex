import fs from 'node:fs'; import path from 'node:path';
const snap=fs.readFileSync('/tmp/codex-current-snapshot.txt','utf8').trim();
const files=fs.readFileSync(snap,'utf8').split(/\\r?\\n/).filter(Boolean);
const outDir='/tmp/codex-pdftext-1780376914';
function safeName(f){return path.basename(f,'.pdf').replace(/["'^a-zA-Z0-9_.-]+/g,'"'_')}
function clean(s){return s.replace(/\\s+/g,' ').trim()}
function inferTitle(text){
 const lines=text.split(/\\r?\\n/).map(clean).filter(l=>l && "'!/''^'"\\d+"'$/.test(l));
 const skip=/''^(Article|Review|OPEN ACCESS|Frontiers|ORIGINAL RESEARCH|Received|Accepted|Published|Copyright|www'"\\.|http|doi:|DOI:|Creative Commons|PAPER|Research Article)"'$/i;
 for(let i=0;i<Math.min(lines.length,80);i++){
   let l=lines[i];
   if(skip.test(l) || l.length<12) continue;
   if(/''^(Author|Abstract|Introduction|Contents|Volume|Issue|Journal|Citation)/i.test(l)) continue;
   let title=l;
   for(let j=i+1;j<Math.min(lines.length,i+4);j++){
     const n=lines[j];
     if(n.length<8 || /abstract|authors?|department|university|received|accepted|published|doi/i.test(n)) break;
     if(/[.!?]$/.test(title) || title.length>140) break;
     title += '"' ' + n;
   }
   return title.slice(0,220);
 }
 return '';
}
for(let idx=0; idx<files.length; idx++){
 const pdf=files[idx]; const base=path.basename(pdf); const textPath=path.join(outDir,safeName(pdf)+'.txt');
 const text=fs.readFileSync(textPath,'utf8'); const lc=text.toLowerCase();
 const title=inferTitle(text);
 const doi=(base.match(/_(10-["'^.]*)'"\\.pdf"'$/)||[])[1]?.replace(/-/g,'"'.') || (text.match(/10\\.\\d{4,9}\\/[\\w.\\-;()/:]+/i)||[])[0] || '';
 const terms=[];
 for(const t of ['food','fish','water','mineral water','bottled','coffee','cashew','peanut','spinach','sunflower','toothpaste','infant formula','heavy metal','lead','cadmium','arsenic','concentration','table']) if(lc.includes(t)) terms.push(t);
 console.log("'`${String(idx+1).padStart(3)} | ${base} | ${title} | terms:${terms.join('"';')}"'`);
}
