import fs from 'node:fs';
import path from 'node:path';
import { spawn } from 'node:child_process';

const snap = fs.readFileSync('/tmp/codex-current-snapshot.txt','utf8').trim();
const files = fs.readFileSync(snap,'utf8').split(/\\r?\\n/).filter(Boolean);
const outDir = '/tmp/codex-pdftext-1780376914';
fs.mkdirSync(outDir, {recursive:true});
function safeName(f){ return path.basename(f, '.pdf').replace(/["'^a-zA-Z0-9_.-]+/g,'"'_'); }
function run(cmd,args){
  return new Promise((resolve)=>{
    const p=spawn(cmd,args,{stdio:['ignore','pipe','pipe']});
    let stdout='', stderr='';
    p.stdout.on('data',d=>stdout+=d);
    p.stderr.on('data',d=>stderr+=d);
    p.on('close',code=>resolve({code,stdout,stderr}));
  });
}
async function processPdf(pdf){
  const name=safeName(pdf);
  const textPath=path.join(outDir, name+'.txt');
  const infoPath=path.join(outDir, name+'.info.txt');
  const [info, text] = await Promise.all([
    run('pdfinfo',[pdf]),
    run('pdftotext',['-layout', pdf, textPath])
  ]);
  fs.writeFileSync(infoPath, "'`code=${info.code}'"\\n"'${info.stdout}${info.stderr ? '"'\\nSTDERR:\\n'+info.stderr : ''}"'`);
  return {pdf, textPath, infoPath, infoCode: info.code, textCode: text.code, stderr: text.stderr.slice(0,500)};
}
let idx=0, done=0; const results=[]; const concurrency=10;
async function worker(){
  while(idx<files.length){
    const pdf=files[idx++];
    const r=await processPdf(pdf);
    results.push(r); done++;
    if(done%10===0 || done===files.length) console.log(`extracted ${done}/${files.length}`);
  }
}
await Promise.all(Array.from({length:concurrency}, worker));
fs.writeFileSync('"'/tmp/codex-pdftext-1780376914-results.json', JSON.stringify({outDir, results}, null, 2));
const failures=results.filter(r=>r.textCode"'!==0 || r.infoCode!==0);
console.log(JSON.stringify({total:files.length, outDir, failures:failures.length, failureSamples:failures.slice(0,10)}, null, 2));
