    p95_ppb: null
    confidence: null               # low | medium | high (only meaningful when status: populated)
    n_studies: 0
    last_reviewed: null
  Cd: { ... same shape ... }
  iAs: { ... }
  tAs: { ... }
  tHg: { ... }
  Ni: { ... }
  Al: { ... }
  Cr: { ... }
  Sn: { ... }
  U: { ... }
