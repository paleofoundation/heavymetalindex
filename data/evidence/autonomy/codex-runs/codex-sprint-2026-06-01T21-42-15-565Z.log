const now=new Date().toISOString();
function parse(line){let out=[],cur='',q=false;for(let i=0;i<line.length;i++){const c=line[i]; if(q&&c==='\"'&&line[i+1]==='\"'){cur+='\"';i++;continue} if(c==='\"'){q="'!q;continue} if(c==='"','&&"'!q){out.push(cur);cur='"'';continue} cur+=c} out.push(cur); return out}
function csv(v){const s=String(v??''); return /[\",\\n\\r]/.test(s)?"'`"${s.replaceAll('"'\"','\"\"')}\""'`:s}
function normDoi(v){return String(v||'"'').trim().toLowerCase().replace(/"'^https?:'"\\/\\/(dx\\.)?doi\\.org\\//,'').replace(/"'^doi:'"\\s*/,'').replaceAll(/\\s+/g,'')}
const want=new Set(fs.readFileSync(snap,'utf8').trim().split(/\\r?\\n/).filter(Boolean).map(p=>path.basename(p)));
const aLines=fs.readFileSync(auditPath,'utf8').split(/\\r?\\n/).filter(Boolean); const ah=parse(aLines[0]); const decisions=new Map();
for(const l of aLines.slice(1)){const c=parse(l); const o=Object.fromEntries(c.map((v,i)=>[ah[i],v])); const b=path.basename(o.downloaded_path||''); const d=String(o.decision||''); if(want.has(b) && (d.startsWith('skip:')||d==='ingested')) decisions.set(b,o)}
const doiToCite=new Map();
for(const file of fs.readdirSync('wiki/sources').filter(f=>f.endsWith('.md'))){const s=fs.readFileSync(path.join('wiki/sources',file),'utf8'); const dm=s.match(/"'^doi:'"\\s*\"?(["'^"'"\\n]+)\"?/m); const cm=s.match(/"'^cite_key:'"\\s*\"?(["'^"'"\\n]+)\"?/m); if(dm) doiToCite.set(normDoi(dm[1]), cm?cm[1]:path.basename(file,'.md'))}
const lines=fs.readFileSync(trackerPath,'utf8').split(/\\r?\\n/).filter(Boolean); const h=parse(lines[0]); let updates=0;
const out=[h.join(',')];
for(const l of lines.slice(1)){
  const c=parse(l); while(c.length<h.length)c.push(''); const o=Object.fromEntries(c.map((v,i)=>[h[i],v])); const b=path.basename(o.pdf_path||''); const d=decisions.get(b);
  if(d){
    const decision=String(d.decision||'');
    if(decision==='ingested'){
      o.status='ingested-by-codex';
