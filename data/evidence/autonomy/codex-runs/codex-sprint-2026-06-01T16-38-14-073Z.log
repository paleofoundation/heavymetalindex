    lines[row.i] = row.cols.join(',');
    updated++;
  } else {
    lines.splice(lines.length - (lines.at(-1) === '' ? 1 : 0), 0, [p, handleFor(p), status, now, cite, notes].join(','));
    added++;
  }
}
