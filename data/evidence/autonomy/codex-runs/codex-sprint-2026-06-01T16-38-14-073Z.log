const fs = require('fs');
const auditPath = 'data/evidence/wishlist-fetch-audit.csv';
const decisions = new Map(JSON.parse(fs.readFileSync('/tmp/codex-skip-decisions.json','utf8')).map(x => [x.path, x]));
function parseCSV(text){
  const rows=[]; let row=[]; let cur=''; let q=false;
  for(let i=0;i<text.length;i++){
    const c=text[i];
    if(q){
      if(c==='\"' && text[i+1]==='\"'){cur+='\"'; i++;}
      else if(c==='\"') q=false;
      else cur+=c;
    } else {
      if(c==='\"') q=true;
      else if(c===','){row.push(cur); cur='';}
      else if(c==='\\n') { row.push(cur); rows.push(row); row=[]; cur=''; }
      else if(c==='\\r') {}
      else cur+=c;
    }
  }
  if(cur.length || row.length){ row.push(cur); rows.push(row); }
  return rows;
}
function esc(v){ v = String(v ?? ''); return /[\",\\n\\r]/.test(v) ? '\"' + v.replace(/\"/g,'\"\"') + '\"' : v; }
const rows = parseCSV(fs.readFileSync(auditPath,'utf8'));
const header = rows[0];
const idx = Object.fromEntries(header.map((h,i)=>[h,i]));
let updated=0;
for(const row of rows.slice(1)){
  const path = row[idx.downloaded_path];
  const d = decisions.get(path);
  if("'!d) continue;
  row[idx.decision] = d.decision;
  if(idx.negative_hits >= 0) row[idx.negative_hits] = d.note;
  updated++;
}
fs.writeFileSync(auditPath, rows.map(r => r.map(esc).join('"',')).join('\\n') + '\\n');
console.log(JSON.stringify({updated}, null, 2));
