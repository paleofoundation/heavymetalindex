  trackerAdd.push([rel, handle, status, now, cite, notes])
}
fs.appendFileSync(trackerPath, trackerAdd.map((row) => trackerHeader.map((_, i) => csv(row[i] || '"'')).join(',')).join('\\n') + '\\n')
