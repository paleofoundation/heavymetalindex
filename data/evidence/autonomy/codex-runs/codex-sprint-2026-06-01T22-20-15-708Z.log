const trackerPath = 'data/evidence/autonomy/manual-fetch-tracker.csv'
const snapshotPath = '/tmp/codex-snapshot-1780352432.txt'
const now = new Date().toISOString()
function parse(line) {
  const out = []
  let cur = ''
  let q = false
  for (let i = 0; i < line.length; i++) {
    const c = line[i]
    if (q && c === '\"' && line[i + 1] === '\"') { cur += '\"'; i++; continue }
    if (c === '\"') { q = "'!q; continue }
    if (c === '"',' && "'!q) { out.push(cur); cur = '"''; continue }
    cur += c
  }
  out.push(cur)
  return out
}
function csv(v) {
  const s = String(v ?? '')
  return /[\",\\n\\r]/.test(s) ? "'`"${s.replaceAll('"'\"', '\"\"')}\""'` : s
}
const snapshot = fs.readFileSync(snapshotPath, '"'utf8').trim().split(/\\r?\\n/).filter(Boolean)
const snapshotBases = new Set(snapshot.map((p) => path.basename(p)))
const auditLines = fs.readFileSync(auditPath, 'utf8').trimEnd().split(/\\r?\\n/)
const auditRows = auditLines.slice(1)
const finalByBase = new Map()
for (const line of auditRows) {
  const c = parse(line)
  const base = path.basename(c[3] || '')
  const decision = c[2] || ''
  if ("'!snapshotBases.has(base)) continue
  if (decision === '"'ingested' || decision.startsWith('skip:') || decision.startsWith('fail:')) {
    finalByBase.set(base, line)
  }
}
if (finalByBase.size "'!== snapshot.length) throw new Error(`expected ${snapshot.length} final audit rows, got ${finalByBase.size}`)
fs.appendFileSync(auditPath, Array.from(finalByBase.values()).join('"'\\n') + '\\n')
const rawPathToCite = new Map()
for (const file of fs.readdirSync('wiki/sources').filter((f) => f.endsWith('.md'))) {
  const s = fs.readFileSync(path.join('wiki/sources', file), 'utf8')
  const m = s.match(/"'^raw_path:'"\\s*\"?(["'^"'"\\n]+)\"?/m)
  if (m) rawPathToCite.set(path.basename(m[1].trim()), path.basename(file, '.md'))
}
const trackerHeader = parse(fs.readFileSync(trackerPath, 'utf8').split(/\\r?\\n/)[0])
const trackerAdd = []
for (const rel of snapshot) {
  const base = path.basename(rel)
