  appendCsv(trackerPath, trackerHeader, claimRows)
}

console.log(JSON.stringify({ snapshot: snapshot.length, claimed: claimRows.length, skippedAlreadyClaimedOrIngested: snapshot.length - work.length, mode }, null, 2))

