]
# tracker update
fp=Path('data/evidence/autonomy/manual-fetch-tracker.csv')
lines=fp.read_text().splitlines()
paths={x[0]:x for x in items}
out=[]
for line in lines:
    if not line.strip() or line.startswith('pdf_path,'):
        out.append(line); continue
    p=line.split(',',1)[0].strip('\"')
    if p in paths:
        _, wid, decision, note, doi, year, journal=paths[p]
        handle='AUTO_'+Path(p).stem.replace('_','-')
