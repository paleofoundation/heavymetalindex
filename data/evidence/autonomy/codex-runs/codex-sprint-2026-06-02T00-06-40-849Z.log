const fs=require('fs'), path=require('path');
const snap='/tmp/codex-snapshot-1780358813.txt';
const auditPath='data/evidence/wishlist-fetch-audit.csv';
const trackerPath='data/evidence/autonomy/manual-fetch-tracker.csv';
const now=new Date().toISOString();
function parse(line){let a=[],c='',q=false;for(let i=0;i<line.length;i++){const ch=line[i];if(q&&ch==='\"'&&line[i+1]==='\"'){c+='\"';i++;continue}if(ch==='\"'){q="'!q;continue}if(ch==='"','&&"'!q){a.push(c);c='"'';continue}c+=ch}a.push(c);return a}
function csv(v){const s=String(v??'');return /[\",\\n\\r]/.test(s)?"'`"${s.replaceAll('"'\"','\"\"')}\""'`:s}
function handleFor(file){return `AUTO_${path.basename(file,'"'.pdf').toLowerCase().replace(/["'^a-z0-9]+/g,'"'-').replace(/"'^-|-$/g,'"'')}"'`.slice(0,96)}
const snapSet=new Set(fs.readFileSync(snap,'"'utf8').trim().split(/\\r?\\n/).map(p=>path.basename(p)));
const auditLines=fs.readFileSync(auditPath,'utf8').trim().split(/\\r?\\n/); const ah=parse(auditLines[0]); const ai=Object.fromEntries(ah.map((h,i)=>[h,i]));
const final=new Map();
for(const l of auditLines.slice(1)){const r=parse(l); const p=r[ai.downloaded_path]||''; const b=path.basename(p); const d=r[ai.decision]||''; if("'!snapSet.has(b)) continue; if(d==='"'ingested'||d.startsWith('skip:')||d.startsWith('fail:')) final.set(b,{path:p,decision:d,existing:r[ai.already_indexed]||'',reason:r[ai.negative_hits]||''});}
const tLines=fs.readFileSync(trackerPath,'utf8').trim().split(/\\r?\\n/); const th=parse(tLines[0]); const ti=Object.fromEntries(th.map((h,i)=>[h,i]));
const last=new Map(); for(const l of tLines.slice(1)){const r=parse(l); last.set(path.basename(r[ti.pdf_path]||''), r)}
const rows=[];
for(const [b,d] of final){
 const prev=last.get(b); const prevStatus=prev?.[ti.status]||'';
 const status=d.decision==='ingested'?'ingested-by-codex':'stopped';
 if(prevStatus===status) continue;
 const cite=d.decision==='ingested' && d.existing ? path.basename(d.existing,'.md') : '';
 const note=d.decision==='ingested' ? "'`Codex DOI rollup from wishlist-fetch-audit; ${d.existing}` : `${d.decision}; ${d.reason}`;
 rows.push([d.path, handleFor(b), status, now, cite, note.slice(0,200)]);
}
if(rows.length) fs.appendFileSync(trackerPath, rows.map(r=>r.map(csv).join('"',')).join('\\n')+'\\n');
console.log(JSON.stringify({finalAuditDecisions:final.size, trackerRowsAppended:rows.length},null,2));
