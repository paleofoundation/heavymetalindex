+| Medicated | SP1 | 0.10 | 0.19 | 0.40 | 0.56 | 0.03 | 0.07 |
+| Medicated | SP2 | 0.16 | 0.22 | 0.61 | 0.89 | 0.05 | 0.07 |
+| Medicated | SP3 | 0.08 | 0.12 | 1.03 | 1.93 | 0.02 | 0.04 |
+| Medicated | SP4 | 0.09 | 0.15 | 0.18 | 0.47 | 0.03 | 0.03 |
+| Medicated | SP5 | 0.11 | 0.20 | 0.22 | 0.33 | 0.03 | 0.03 |
+| Moisturizing | SP6 | 0.11 | 0.19 | 6.42 | 0.69 | 0.03 | 0.04 |
+| Moisturizing | SP7 | 0.10 | 0.20 | 0.12 | 0.59 | 0.04 | 0.02 |
+| Moisturizing | SP8 | 0.12 | 0.24 | 0.10 | 0.95 | 0.04 | 0.01 |
