/bin/zsh -lc "node - <<'NODE'
const fs=require('fs');
const snap='/tmp/codex-snapshot-1780427192.txt';
const tracker='data/evidence/autonomy/manual-fetch-tracker.csv';
const ledger='data/evidence/autonomy/agent-events.jsonl';
const claimed=new Set();
for (const line of fs.readFileSync(tracker,'utf8').split(/\\r?\\n/).slice(1)) {
  if ("'!line.trim()) continue;
  const m=line.match(/''^("(?:[''^"]|"")*"|[''^,]*),("(?:[''^"]|"")*"|[''^,]*),("(?:[''^"]|"")*"|[''^,]*)/);
  if (!m) continue;
  const path=m[1].replace(/''^"|"$/g,'"'');
  const status=m[3].replace(/"'^"|"$/g,'"'');
  if (/"'^(claimed|ingested)/.test(status)) claimed.add(path);
}
const handled=new Set();
for (const line of fs.readFileSync(ledger,'"'utf8').split(/\\r?\\n/)) {
  if ("'!line.trim()) continue;
  try { const o=JSON.parse(line); if (o.source_path && o.status && (o.status.startsWith('"'skip:') || o.status==='ingested' || o.status==='escalated')) handled.add(o.source_path); } catch {}
}
let out=[];
for (const p of fs.readFileSync(snap,'utf8').split(/\\r?\\n/)) {
 if ("'!p) continue;
 if (!claimed.has(p) && !handled.has(p)) out.push(p);
 if (out.length>=12) break;
}
console.log(out.join('"'\\n'));
