# Pre-commit hook per CLAUDE.md Part 5b.
#
# When a commit touches wiki/sources/, refresh the routing audit and abort
# the commit if the audit cannot regenerate cleanly (blocking-malformed
# entries; missing cite_key on a source page). The audit's sibling logs
# (routing_unresolved.csv, routing_malformed.csv) catch advisory and strict
# issues without blocking the commit during the migration period.
#
# Skips the audit when no wiki/sources/ files are staged so commits to
# unrelated paths stay fast.

# ── Bidirectional commit mutex ───────────────────────────────────────────────
# Acquire the commit lock so we don't race the autonomy daemon's git-add-A.
# The lock is released on hook exit. If the lock can't be acquired in 60s,
# the daemon (or another manual commit) is doing real work — abort cleanly
# and let the user retry. Bypass with HMI_SKIP_COMMIT_LOCK=1 if the hook
# itself is the problem (last resort, surfaces in stderr).
if [ "${HMI_SKIP_COMMIT_LOCK:-0}" != "1" ]; then
  # shellcheck source=../tools/autonomy/commit-lock.sh
  . "$(git rev-parse --show-toplevel)/tools/autonomy/commit-lock.sh"
  if ! acquire_lock "pre-commit-${USER:-unknown}-$$" 60; then
    echo "pre-commit: another commit is in progress. Wait a moment and retry."
    echo "  (set HMI_SKIP_COMMIT_LOCK=1 to bypass; only do this if you know what you are doing)"
    exit 1
  fi
  trap release_lock EXIT INT TERM
fi

if git diff --cached --name-only | grep -q '^wiki/sources/'; then
  echo "pre-commit: wiki/sources/ touched; running routing audit..."
  if ! npm run --silent evidence:source-routes; then
    echo "pre-commit: routing audit failed. Fix the blocking-malformed source(s) named above (typically missing cite_key) and re-commit."
    exit 1
  fi

  # If the audit regenerated the audit CSVs, stage them so the commit
  # includes the refreshed state instead of leaving it as a dirty working
  # tree post-commit.
  for f in data/evidence/product_source_routing_audit.csv data/evidence/routing_unresolved.csv data/evidence/routing_malformed.csv; do
    if [ -f "$f" ] && ! git diff --quiet -- "$f"; then
      git add "$f"
    fi
  done

  # DOI completeness check. Catches the 2026-05-12 night-ingest failure mode
  # at commit time instead of at the next build's prebuild audit. A source
  # page passes if doi has a non-null value, OR no_doi_assigned: true is set
  # (declared no-DOI venue), OR source_type is textbook-chapter.
  doi_bad=0
  for f in $(git diff --cached --name-only --diff-filter=AM | grep '^wiki/sources/.*\.md$'); do
    head -40 "$f" > /tmp/.husky-fm.$$
    doi_line=$(grep -E '^doi:' /tmp/.husky-fm.$$ | head -1 | sed -E 's/^doi:[[:space:]]*//;s/^"//;s/"$//')
    no_doi_assigned=$(grep -cE '^no_doi_assigned:[[:space:]]*true' /tmp/.husky-fm.$$ || true)
    src_type=$(grep -E '^source_type:' /tmp/.husky-fm.$$ | head -1 | sed -E 's/^source_type:[[:space:]]*//;s/^"//;s/"$//')
    is_missing=0
    case "$doi_line" in
      ""|null|unknown) is_missing=1 ;;
    esac
    if [ "$is_missing" = "1" ] && [ "$no_doi_assigned" = "0" ] && [ "$src_type" != "textbook-chapter" ]; then
      echo "pre-commit: $f has doi: '$doi_line' and no no_doi_assigned: true marker."
      doi_bad=$((doi_bad + 1))
    fi
    rm -f /tmp/.husky-fm.$$
  done
  if [ "$doi_bad" -gt 0 ]; then
    echo "pre-commit: $doi_bad staged source page(s) have missing DOI metadata."
    echo "Either fill in doi (preferred) or add no_doi_assigned: true with a real publisher access_url."
    echo "See wiki/lint/2026-05-13-doi-fallback-followup.md for context."
    exit 1
  fi
fi

# ── Wiki-edit audit write barrier ────────────────────────────────────────────
# Every commit that touches wiki/**/*.md must include a matching new audit row
# in data/evidence/wiki_edit_audit.jsonl. This enforces the invariant that no
# automated worker edits a wiki page without a recorded provenance trail.
#
# Exceptions (manual / non-automated edits):
#   - Set WIKI_EDIT_AUDIT_SKIP=1 in the environment when making a manual,
#     human-authored change that has no corresponding audit row.
#   - The hook prints a warning so the bypass is visible in the terminal.

_wiki_pages=$(git diff --cached --name-only --diff-filter=AM | grep '^wiki/.*\.md$' || true)

if [ -n "$_wiki_pages" ]; then
  if [ "${WIKI_EDIT_AUDIT_SKIP:-0}" = "1" ]; then
    echo "pre-commit: WIKI_EDIT_AUDIT_SKIP=1 — skipping audit-row check for manual edit."
  else
    # Check that data/evidence/wiki_edit_audit.jsonl is also staged (i.e. new
    # rows were appended in this commit).
    if ! git diff --cached --name-only | grep -q '^data/evidence/wiki_edit_audit\.jsonl$'; then
      echo "pre-commit: wiki/**/*.md files are staged but data/evidence/wiki_edit_audit.jsonl has no staged changes."
      echo ""
      echo "  Staged wiki pages:"
      echo "$_wiki_pages" | sed 's/^/    /'
      echo ""
      echo "  Every automated wiki edit must call recordEditOrAbort() from"
      echo "  tools/evidence/wiki-edit.ts before mutating the file."
      echo "  This appends a row to data/evidence/wiki_edit_audit.jsonl which"
      echo "  must be staged alongside the wiki change."
      echo ""
      echo "  If this is a manual human-authored edit, bypass with:"
      echo "    WIKI_EDIT_AUDIT_SKIP=1 git commit …"
      exit 1
    fi
    echo "pre-commit: wiki_edit_audit.jsonl is staged alongside wiki changes — OK."
  fi
fi

