  `command: ${codexBinary} ${cliArgs.join(" ")}`,
  `wall-clock budget: ${timeoutMins} min`,
  `elapsed: ${elapsed}s`,
  `exit code: ${res.status ?? "(no exit)"}`,
  res.error ? `error: ${res.error.message}` : "",
