The candidate set is splitting cleanly: some true occurrence studies, but a large fraction are filename false positives where “formula,” “casein,” or “fruit” appears in an unrelated toxicology, materials, microbiome, or agronomy paper. I’m separating “real ingest” from “skip” using the PDF text and the required metadata rule, especially DOI presence in the PDF itself.
exec
/bin/zsh -lc "node - <<'NODE'
const fs=require('fs'); const m=JSON.parse(fs.readFileSync('data/evidence/autonomy/codex-real-ingest-candidates-2026-06-01T19-50-53-789Z.json','utf8'));
const names=m.slice(10,33);
for (const r of names){
  const text=fs.readFileSync(r.text_path,'utf8');
  const lines=text.split(/\\r?\\n/).map(s=>s.trim()).filter(Boolean);
  const hits=[];
  const pats=/(mg\\/kg|µg\\/kg|ug\\/kg|mg kg|µg kg|ug kg|ppm|ppb|ng\\/g|µg\\/g|ug\\/g|mg\\/l|µg\\/l|ug\\/l|lead|cadmium|arsenic|mercury|chromium|nickel|aluminium|aluminum|table\\s+\\d|ICP|AAS|formula|casein|milk|food|fruit|infant)/i;
  for (let i=0;i<lines.length&&hits.length<8;i++) if (pats.test(lines[i])) hits.push("'`${i+1}: ${lines[i].slice(0,180)}`);
  console.log(`'"\\nFILE "'${r.filename}`);
  console.log(`HEAD ${lines.slice(0,22).join('"' | ').slice(0,650)}"'`);
  console.log(`HITS ${hits.join('"' || ')}"'`);
}
