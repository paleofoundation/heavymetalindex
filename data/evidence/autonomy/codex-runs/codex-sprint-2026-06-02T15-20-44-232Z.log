exec
/bin/zsh -lc "node - <<'NODE'
const fs=require('fs');
const file='data/evidence/autonomy/manual-fetch-tracker.csv';
function parse(line){const out=[];let cur='',q=false;for(let i=0;i<line.length;i++){const ch=line[i];if(q){if(ch==='\"'&&line[i+1]==='\"'){cur+='\"';i++;}else if(ch==='\"')q=false;else cur+=ch;}else{if(ch==='\"')q=true;else if(ch===','){out.push(cur);cur='';}else cur+=ch;}}out.push(cur);return out;}
function esc(v){v=String(v??'').replace(/\\r/g,'').replace(/\\n/g,' ');return /[\",]/.test(v)?'\"'+v.replace(/\"/g,'\"\"')+'\"':v;}
const text=fs.readFileSync(file,'utf8');
const rows=text.split(/\\n/).filter((l,i,a)=>"'!(i===a.length-1 && l==='"'')).map(parse);
fs.writeFileSync(file, rows.map(r=>r.map(esc).join(',')).join('\\r\\n')+'\\r\\n');
console.log('normalized rows', rows.length);
