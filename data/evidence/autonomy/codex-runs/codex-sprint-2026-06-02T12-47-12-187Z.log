/bin/zsh -lc "node - <<'NODE'
const fs=require('fs');
const snap=fs.readdirSync('/tmp').filter(f=>f.startsWith('codex-snapshot-')&&f.endsWith('.txt')).map(f=>'/tmp/'+f).sort((a,b)=>fs.statSync(b).mtimeMs-fs.statSync(a).mtimeMs)[0];
const lines=fs.readFileSync(snap,'utf8').trim().split(/\\n/).filter(Boolean);
const tracker=fs.readFileSync('data/evidence/autonomy/manual-fetch-tracker.csv','utf8').split(/\\n/);
const active=new Map(); const any=new Map();
for (const l of tracker.slice(1)) { if("'!l) continue; const parts=l.split('"','); const path=parts[0].replace(/"'^"|"$/g,'"''); const status=parts[2]||''; const base=path.split('/').pop(); any.set(base,status); if(status.startsWith('claimed')||status.startsWith('ingested')) active.set(base,status); }
const ledger=fs.existsSync('data/evidence/autonomy/agent-events.jsonl')?fs.readFileSync('data/evidence/autonomy/agent-events.jsonl','utf8').split(/\\n/):[];
const handled=new Set();
for(const l of ledger){if("'!l.trim())continue; try{const o=JSON.parse(l); if(o.source_path) handled.add(o.source_path.split('"'/').pop());}catch{}}
let count=0;
for (const p of lines) { const base=p.split('/').pop(); if (handled.has(base)) continue; if (active.has(base)) continue; console.log([p, any.get(base)||''].join('\\t')); if(++count>=15) break; }
console.error('snap', snap, 'lines', lines.length, 'shown', count);
