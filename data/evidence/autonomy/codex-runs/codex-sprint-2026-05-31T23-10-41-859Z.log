+  if (!fs.existsSync(file) || fs.statSync(file).size === 0) fs.writeFileSync(file, header.join(",") + "\n")
+  const lines = rows.map((row) => header.map((h) => csv(row[h] ?? "")).join(",")).join("\n")
+  fs.appendFileSync(file, lines + "\n")
+}
+
+function parseCsvLine(line) {
