+  return path.basename(filename, ".pdf").split("_")[0]
+}
+
+function sectionFromFilename(filename) {
+  const stem = path.basename(filename, ".pdf")
+  return stem.replace(/_\d{4}_.+$/, "").replace(/^gap-/, "").replace(/^auto-/, "")
