+    if (!m) continue
+    const d = normDoi(m[1])
+    if (d && d !== "null") map.set(d, `wiki/sources/${file}`)
+  }
+  return map
+}
+
+function extractDoi(text) {
+  const m = text.match(/\b10\.\d{4,9}\/[-._;()/:A-Z0-9]+/i)
+  return m ? m[0].replace(/[)\].,;]+$/, "") : ""
+}
