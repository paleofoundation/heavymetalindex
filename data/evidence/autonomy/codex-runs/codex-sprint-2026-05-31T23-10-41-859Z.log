+    wishlist_section: sectionFromFilename(r.filename),
+    decision: r.decision,
+    downloaded_path: r.rel,
+    relevance_score: "",
+    positive_score: "",
+    negative_penalty: "",
+    negative_hits: r.reason || "",
+    food_hits: r.foodHits || "",
+    domain_match: r.domainMatch || "",
+    already_indexed: r.existingPage || "",
+    title: r.title || "",
+    doi: r.doi || "",
+    year: r.year || "",
+    journal: r.journal || "",
