+
+function parseArgs(argv) {
+  const m = new Map()
+  for (const a of argv) {
+    if (!a.startsWith("--")) continue
+    const i = a.indexOf("=")
+    if (i === -1) m.set(a.slice(2), "true")
+    else m.set(a.slice(2, i), a.slice(i + 1))
+  }
+  return m
+}
