+
+if (!snapshotPath || !fs.existsSync(snapshotPath)) {
+  console.error("No snapshot found. Pass --snapshot=/tmp/codex-snapshot-....txt")
+  process.exit(1)
+}
+
+const snapshot = fs.readFileSync(snapshotPath, "utf8")
+  .split(/\r?\n/)
+  .map((s) => s.trim())
+  .filter(Boolean)
+
