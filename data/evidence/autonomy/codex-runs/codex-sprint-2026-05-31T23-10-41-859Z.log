+  for (const file of fs.readdirSync(sourceDir).filter((f) => f.endsWith(".md"))) {
+    const p = path.join(sourceDir, file)
+    const s = fs.readFileSync(p, "utf8")
+    const m = s.match(/^doi:\s*"?([^"\n]+)"?/m)
+    if (!m) continue
+    const d = normDoi(m[1])
+    if (d && d !== "null") map.set(d, `wiki/sources/${file}`)
