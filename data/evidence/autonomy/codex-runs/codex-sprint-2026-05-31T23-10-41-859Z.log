+    l.length > 30 &&
+    l.length < 220 &&
+    /[a-z]/i.test(l) &&
+    !/^(journal|doi|abstract|keywords|introduction|article|research article|open access)$/i.test(l) &&
+    !/^(vol\.|volume|issn|received|accepted|published)/i.test(l)
+  ) || ""
