+    relevance_score: "",
+    positive_score: "",
+    negative_penalty: "",
+    negative_hits: r.reason || "",
+    food_hits: r.foodHits || "",
+    domain_match: r.domainMatch || "",
+    already_indexed: r.existingPage || "",
+    title: r.title || "",
+    doi: r.doi || "",
+    year: r.year || "",
+    journal: r.journal || "",
+    oa_url: "",
+    cited_by_count: "",
+    query_terms: r.queryTerms || "",
+  }))
+
+if (newAuditRows.length) appendCsv(auditPath, auditHeader, newAuditRows)
+
+const out = {
