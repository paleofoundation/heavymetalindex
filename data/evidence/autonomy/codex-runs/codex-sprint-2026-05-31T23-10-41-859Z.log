+  } finally {
+    fs.closeSync(fd)
+  }
+}
+
+function extractText(pdf, textPath) {
+  return new Promise((resolve) => {
+    const child = spawn("pdftotext", ["-enc", "UTF-8", "-f", "1", "-l", "16", pdf, textPath], { stdio: "ignore" })
+    child.on("close", () => {
+      try { resolve(fs.readFileSync(textPath, "utf8")) } catch { resolve("") }
