+function isPdf(file) {
+  const fd = fs.openSync(file, "r")
+  try {
+    const head = Buffer.alloc(5)
+    fs.readSync(fd, head, 0, 5, 0)
+    if (head.toString() !== "%PDF-") return false
+    const stat = fs.statSync(file)
