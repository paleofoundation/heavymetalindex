+function metadata(text) {
+  const lines = text.split(/\r?\n/).map((l) => l.trim()).filter(Boolean).slice(0, 80)
+  const doi = extractDoi(text)
+  const year = (text.match(/\b(20[0-2]\d|19[6-9]\d)\b/) || [])[1] || ""
