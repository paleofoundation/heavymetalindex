+  process.exit(1)
+}
+
+const snapshot = fs.readFileSync(snapshotPath, "utf8")
+  .split(/\r?\n/)
+  .map((s) => s.trim())
+  .filter(Boolean)
+
+const tracker = loadCsv(trackerPath)
+const trackerHeader = tracker.header.length ? tracker.header : ["pdf_path", "handle", "status", "last_tick", "cite_key", "notes"]
