+  }
+  return {
+    ...item,
+    decision: "real-ingest",
+    doi,
+    ...meta,
+    reason: "metal + target matrix + concentration/statistic signals present; needs source-page ingest",
+    text_path: textPath,
+    queryTerms: sectionFromFilename(item.filename),
