+  const journal = lines.find((l) => /\b(journal|food|chemistry|environment|science|pollution|toxicol|water|nutrition|foods)\b/i.test(l) && l.length < 160) || ""
+  return { title, year, journal, doi }
+}
+
+function isPdf(file) {
