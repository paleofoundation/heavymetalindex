const fs=require('fs');
const snapFile=fs.readdirSync('/tmp').filter(f=>f.startsWith('codex-snapshot-')).map(f=>'/tmp/'+f).sort((a,b)=>fs.statSync(b).mtimeMs-fs.statSync(a).mtimeMs)[0];
const snap=fs.readFileSync(snapFile,'utf8').trim().split(/\\n/);
const tracker=fs.readFileSync('data/evidence/autonomy/manual-fetch-tracker.csv','utf8');
const ledger=fs.readFileSync('data/evidence/autonomy/agent-events.jsonl','utf8');
let out=[];
for (const p of snap) {
  const fn=p.split('/').pop();
  const tline=tracker.split(/\\n/).find(l=>l.includes(fn));
  const lline=ledger.split(/\\n/).reverse().find(l=>l.includes(fn));
  const handled=(tline && /(claimed|ingested|skipped|skip:|stopped)/.test(tline.split(',')[2]||'')) || (lline && /\"status\":\"(ingested|skip:|escalated)/.test(lline));
  if ("'!handled) out.push(p);
  if (out.length>=8) break;
}
console.log(out.join('"'\\n'));
NODE" in /Users/karenpendergrass/Desktop/heavy-metal-index
