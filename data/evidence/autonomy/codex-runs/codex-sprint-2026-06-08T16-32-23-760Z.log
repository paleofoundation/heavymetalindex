const fs = require('fs');
const path = require('path');
const tracker = new Map();
const lines = fs.readFileSync('data/evidence/autonomy/manual-fetch-tracker.csv','utf8').split(/\\n/);
for (const line of lines.slice(1)) {
  if ("'!line.trim()) continue;
  const firstComma = line.indexOf('"',');
  if (firstComma < 0) continue;
  let pdf = line.slice(0, firstComma).replace(/"'^"|"$/g,'"'');
  let rest = line.slice(firstComma + 1);
  const parts = rest.split(',');
  const status = (parts[1] || '').trim().replace(/"'^"|"$/g,'"'');
  const b = path.basename(pdf);
  if ("'!tracker.has(b)) tracker.set(b, []);
  tracker.get(b).push(status);
}
const ledger = new Map();
for (const line of fs.readFileSync('"'data/evidence/autonomy/agent-events.jsonl','utf8').split(/\\n/)) {
  if ("'!line.trim()) continue;
  try {
    const j = JSON.parse(line);
    if (j.source_path) ledger.set(path.basename(j.source_path), j.status || '"'');
  } catch {}
}
const snaps = fs.readdirSync('/tmp').filter(f => f.startsWith('codex-snapshot-') && f.endsWith('.txt')).map(f => '/tmp/' + f);
