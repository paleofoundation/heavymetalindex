for (const p of snapLines) {
  const b=path.basename(p);
  const tlines=trackerText.split(/\\n/).filter(l=>l.includes(b));
  const llines=ledgerText.split(/\\n/).filter(l=>l.includes(b));
  const statusText=tlines.join('\\n');
  if (/,(claimed["'^,]*|ingested[''^,]*),/.test(statusText)) counts.claimedOrIngested++;
  else if (llines.some(l=>/"status":"(ingested|skip)/.test(l))) counts.ledgerHandled++;
  else if (/,(skipped[''^,]*|skip:[''^,]*),/.test(statusText)) counts.skippedTracker++;
  else { counts.maybeOpen++; if (examples.length<20) examples.push({p,b,tlines:tlines.slice(0,2),ledger:llines.slice(-1)}); }
}
console.log(counts);
