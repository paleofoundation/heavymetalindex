The tracker CSV has embedded carriage returns in older rows, so strict CSV parsing fails. For this bounded queue I’m using a conservative line scan keyed by exact auto-fetched paths and status prefixes, which is enough for race-safe claim checks on the current folder.
exec
/bin/zsh -lc 'SNAP=$(ls -t /tmp/codex-snapshot-*.txt | head -1); ruby -e '"'
paths=File.readlines(ARGV[0], chomp: true)
handled={}
File.foreach(\"data/evidence/autonomy/agent-events.jsonl\") do |line|
  sp=line[/\"source_path\":\"(["'^"]+)"/,1]
  st=line[/"status":"([''^"]+)"/,1]
  handled[sp]=true if sp && st && (st=="ingested" || st.start_with?("skip:") || st=="escalated")
end
busy={}
File.foreach("data/evidence/autonomy/manual-fetch-tracker.csv") do |line|
  next unless line.start_with?("raw/manual-fetch/seasonal-geographic-variance/auto-fetched/")
  cols=line.split(",",4)
  p=cols[0]; s=cols[2].to_s
  busy[p]=true if s.start_with?("claimed") || s.start_with?("ingested")
end
n=0
paths.each do |p|
  next if handled[p] || busy[p]
  puts p
  n+=1
  break if n>=8
end
