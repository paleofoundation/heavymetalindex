{n:9,key:'"'mesinger2021-red-deer-heavy-metals',title:'Risk Assessment of Wild Game Meat Intake in the Context of the Prospective Development of the Venison Market in Poland',authors:['Mesinger D','Ocieczek A'],year:2021,pub:'Polish Journal of Environmental Studies',doi:'10.15244/pjoes/124744',metals:['Pb','Cd','tAs','tHg'],ingredients:['meat'],products:['game-meats'],matrices:['red-deer-meat'],jur:['PL'],sample_n:12,pop:'12 red deer doe meat samples from Poland',body:"'`# Mesinger and Ocieczek 2021 - Heavy metals in red deer meat in Poland

