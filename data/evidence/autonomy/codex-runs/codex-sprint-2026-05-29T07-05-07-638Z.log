{n:33,key:'"'sadee2022-erbil-vegetables',title:'Determination of trace metals in vegetables using ICP-MS',authors:['Sadee B A'],year:2022,pub:'ZANCO Journal of Pure and Applied Sciences',doi:'10.21271/zjpas.34.3.9',metals:['tAs','Cd','Cr','Pb','Cu'],ingredients:['vegetables','spinach','celery','leafy-vegetables'],products:['non-root-vegetables','leafy-vegetables-other'],matrices:['edible-vegetables'],jur:['IQ'],sample_n:10,pop:'ten common vegetables from local markets in Erbil, Kurdistan Region, Iraq',body:"'`# Sadee 2022 - Trace metals in vegetables from Erbil markets

