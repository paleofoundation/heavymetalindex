+authors: [Kataoka Y, Watanabe T, Hayashi K, Akiyama H]
+year: 2018
+publication: "Food Hygiene and Safety Science"
+doi: 10.3358/shokueishi.59.269
+source_type: peer-reviewed
+evidence_tier: A
+license: "unknown"
