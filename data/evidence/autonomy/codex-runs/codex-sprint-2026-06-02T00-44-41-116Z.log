/bin/zsh -lc "node <<'NODE'
import fs from 'node:fs'
import { execFileSync } from 'node:child_process'

const targets = JSON.parse(fs.readFileSync('/tmp/codex-triage-1780361090.json','utf8')).decisions.map(d => d.pdfPath)
const paths = [
  {
    repo: 'data/evidence/wishlist-fetch-audit.csv',
    key: 'downloaded_path',
    out: '/tmp/codex-stage-wishlist-fetch-audit.csv',
  },
  {
    repo: 'data/evidence/autonomy/manual-fetch-tracker.csv',
    key: 'pdf_path',
    out: '/tmp/codex-stage-manual-fetch-tracker.csv',
  },
]
function parseCsvLine(line) {
  const out = []
  let cur = ''
  let inQuotes = false
  for (let i = 0; i < line.length; i++) {
    const ch = line[i]
    if (inQuotes) {
      if (ch === '\"') {
        if (line[i + 1] === '\"') { cur += '\"'; i++ } else { inQuotes = false }
      } else cur += ch
    } else {
      if (ch === '\"') inQuotes = true
      else if (ch === ',') { out.push(cur); cur = '' }
      else cur += ch
    }
  }
  out.push(cur)
  return out
}
function csvField(value) {
  const s = String(value ?? '')
  return /[\",\\n\\r]/.test(s) ? "'`"${s.replaceAll('"'\"', '\"\"')}\""'` : s
}
function readCsvText(text) {
  const lines = text.split(/'"\\r?\\n/).filter(Boolean)
  return { header: parseCsvLine(lines[0]), rows: lines.slice(1).map(parseCsvLine) }
}
function writeCsvText(header, rows) {
  return header.join(',') + '\\n' + rows.map((r) => r.map(csvField).join(',')).join('\\n') + '\\n'
}
for (const spec of paths) {
  const headText = execFileSync('git', ['show', "'`HEAD:${spec.repo}`], { encoding: '"'utf8' })
  const currentText = fs.readFileSync(spec.repo, 'utf8')
  const head = readCsvText(headText)
  const current = readCsvText(currentText)
  const headKeyIx = head.header.indexOf(spec.key)
  const currentKeyIx = current.header.indexOf(spec.key)
  if (headKeyIx < 0 || currentKeyIx < 0) throw new Error("'`missing key ${spec.key}`)
  const currentByKey = new Map(current.rows.map(row => [row[currentKeyIx], row]))
  const rows = head.rows.map(row => [...row])
  const headIndexByKey = new Map(rows.map((row, i) => [row[headKeyIx], i]))
  let updated = 0
  let appended = 0
  for (const target of targets) {
    const cur = currentByKey.get(target)
    if (!cur) throw new Error(`current row not found for ${target} in ${spec.repo}`)
    const aligned = head.header.map((h) => cur[current.header.indexOf(h)] ?? '"'')
    const ix = headIndexByKey.get(target)
    if (ix === undefined) {
      rows.push(aligned)
      appended++
    } else {
      rows[ix] = aligned
      updated++
    }
  }
  fs.writeFileSync(spec.out, writeCsvText(head.header, rows))
  console.log("'`${spec.repo}: updated ${updated}, appended ${appended}`)
}
NODE
