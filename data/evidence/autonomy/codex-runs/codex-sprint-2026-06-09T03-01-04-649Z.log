index 0000000000000000000000000000000000000000..65c3533843c8d1d185565b25523565d2e8929ecd
--- /dev/null
+++ b/wiki/sources/bramwell2022-urban-garden-produce-lead.md
@@ -0,0 +1,76 @@
+---
+type: source
+raw_handle: AUTO_ing-non-root-vegetables-pb_2021_10-1007-s10653-021-01095-7
+cite_key: bramwell2022-urban-garden-produce-lead
+title: "Determinants of blood and saliva lead concentrations in adult gardeners on urban agricultural sites"
+authors: ["Lindsay Bramwell", "Jane Entwistle", "Jackie Morton", "Anne-Helen Harding", "Nan Lin"]
+year: 2022
+publication: "Environmental Geochemistry and Health"
+doi: "10.1007/s10653-021-01095-7"
+source_type: peer-reviewed
+evidence_tier: A
+license: "CC BY 4.0"
+raw_path: "raw/manual-fetch/seasonal-geographic-variance/auto-fetched/ing-non-root-vegetables-pb_2021_10-1007-s10653-021-01095-7.pdf"
+metals: [Pb]
+ingredients: ["[[ingredients/root-vegetables]]", "[[ingredients/non-root-vegetables]]", "[[ingredients/vegetables]]", "[[ingredients/potatoes]]", "[[ingredients/raspberries]]", "[[ingredients/blueberries]]", "[[ingredients/apple]]"]
+products: ["[[products/non-root-vegetables]]", "[[products/root-tuber-vegetables]]", "[[products/fresh-fruit]]"]
+matrices: [blood, saliva, urban-agriculture-soil, tap-water, root-vegetables, green-vegetables, herbaceous-fruit, shrub-fruit, tubers, tree-fruit]
+jurisdictions: [GB]
+near_duplicates: []
+sample_n: 72
+sample_population: "43 adult urban-agriculture-site gardeners and 29 matched controls in Newcastle upon Tyne, UK; environmental sampling included nearly 280 soil samples from 31 garden plots plus home tap-water samples and summarized fruit/vegetable Pb data from the same study system."
+updated: 2026-06-09
