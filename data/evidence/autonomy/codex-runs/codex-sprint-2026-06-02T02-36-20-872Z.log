const snapshot='/tmp/codex-snapshot-1780367792.txt';
const tracker='data/evidence/autonomy/manual-fetch-tracker.csv';
function parse(line){const out=[];let cur='',q=false;for(let i=0;i<line.length;i++){const c=line[i]; if(q){if(c==='\"'&&line[i+1]==='\"'){cur+='\"';i++;} else if(c==='\"') q=false; else cur+=c;} else {if(c==='\"') q=true; else if(c===','){out.push(cur);cur='';} else cur+=c;}} out.push(cur); return out;}
function csv(v){v=String(v??''); return /[\",\\n]/.test(v)?"'`"${v.replace(/"/g,'"'\"\"')}\""'`:v;}
function handleFor(p){const b=path.basename(p,'"'.pdf').toLowerCase().replace(/["'^a-z0-9]+/g,'"'-').replace(/"'^-|-$/g,'"'').slice(0,96); return "'`AUTO_${b}`;}
const paths=fs.readFileSync(snapshot,'"'utf8').split(/\\r?\\n/).filter(Boolean);
let text=fs.existsSync(tracker)?fs.readFileSync(tracker,'utf8'):'pdf_path,handle,status,last_tick,cite_key,notes\\n';
