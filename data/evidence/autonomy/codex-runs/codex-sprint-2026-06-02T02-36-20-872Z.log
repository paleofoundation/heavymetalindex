const pats=[/doi/i,/lead|cadmium|arsenic|mercury|nickel|chromium|aluminium|aluminum|heavy metal|trace metal/i,/mg\\/l|mg\\/kg|µg\\/l|ug\\/l|µg\\/kg|ug\\/kg|ppm|ppb/i,/table|sample|water|filter|food/i];
