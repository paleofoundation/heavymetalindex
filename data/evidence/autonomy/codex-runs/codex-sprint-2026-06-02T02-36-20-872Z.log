/bin/zsh -lc "node - <<'NODE'
const fs=require('fs'), path=require('path');
function parse(line){const out=[];let cur='',q=false;for(let i=0;i<line.length;i++){const c=line[i];if(q){if(c==='\"'&&line[i+1]==='\"'){cur+='\"';i++;}else if(c==='\"')q=false;else cur+=c;}else{if(c==='\"')q=true;else if(c===','){out.push(cur);cur='';}else cur+=c;}}out.push(cur);return out;}
const audit='data/evidence/wishlist-fetch-audit.csv';
const lines=fs.readFileSync(audit,'utf8').split(/\\r?\\n/).filter(Boolean); const header=parse(lines[0]);
const rows=lines.slice(1).map(parse); const idx=Object.fromEntries(header.map((h,i)=>[h,i]));
const claim=JSON.parse(fs.readFileSync('/tmp/codex-claimed-1780367792.json','utf8'));
let matches=0; const examples=[];
for(const p of claim.claimed){const base=path.basename(p); const hit=rows.filter(r=>(r[idx.downloaded_path]||'')===p || (r[idx.downloaded_path]||'').endsWith(base) || r.join('|').includes(base)); if(hit.length){matches+=hit.length; if(examples.length<20) examples.push({base, decisions:hit.map(r=>r[idx.decision]), downloaded:hit.map(r=>r[idx.downloaded_path])});}}
console.log(JSON.stringify({claimed:claim.claimed.length,audit_matches:matches,examples},null,2));
