const rows=lines.slice(1).map(parse);
const now=new Date().toISOString();
const claimed=[]; const skipped=[];
for(const p of paths){const base=path.basename(p); const matches=rows.filter(r=>r[0]===p || path.basename(r[0]||'')===base); const statuses=matches.map(r=>r[2]||''); if(statuses.some(s=>s.startsWith('claimed')||s.startsWith('ingested'))){skipped.push({path:p,statuses}); continue;} const row=[p,handleFor(p),'claimed-by-codex',now,'','snapshot /tmp/codex-snapshot-1780367792.txt']; rows.push(row); claimed.push(p);}
const header=lines[0] || 'pdf_path,handle,status,last_tick,cite_key,notes';
const out=header+'\\n'+rows.map(r=>r.map(csv).join(',')).join('\\n')+'\\n';
fs.writeFileSync(tracker,out);
fs.writeFileSync('/tmp/codex-claimed-1780367792.json',JSON.stringify({now,claimed,skipped},null,2));
console.log(JSON.stringify({claimed:claimed.length, skipped_already_claimed_or_ingested:skipped.length, claim_file:'/tmp/codex-claimed-1780367792.json'},null,2));
