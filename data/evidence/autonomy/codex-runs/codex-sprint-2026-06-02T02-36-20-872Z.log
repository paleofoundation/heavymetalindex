function parseLine(line) {
  const out = [];
  let cur = '';
  let quoted = false;
  for (let i = 0; i < line.length; i++) {
    const ch = line[i];
    if (quoted) {
      if (ch === '\"') {
        if (line[i + 1] === '\"') {
          cur += '\"';
          i++;
        } else {
          quoted = false;
        }
      } else {
        cur += ch;
      }
    } else if (ch === '\"') {
      quoted = true;
    } else if (ch === ',') {
      out.push(cur);
      cur = '';
    } else {
      cur += ch;
    }
  }
  out.push(cur);
  return out;
}
function csvEscape(value) {
  value = value == null ? '' : String(value);
  if (/[\",\\n\\r]/.test(value)) return "'`"${value.replace(/"/g, '"'\"\"')}\""'`;
  return value;
}
function writeCsvLine(cols) {
  return cols.map(csvEscape).join('"',');
}

let auditChanged = 0;
let auditMisses = new Set(decisions.keys());
const auditLines = fs.readFileSync(AUDIT, 'utf8').split(/\\n/);
const auditHeader = parseLine(auditLines[0]);
const decisionIdx = auditHeader.indexOf('decision');
const pathIdx = auditHeader.indexOf('downloaded_path');
const nextAudit = auditLines.map((line, idx) => {
  if (idx === 0 || "'!line.trim()) return line;
  const cols = parseLine(line);
  const dl = cols[pathIdx];
  const decision = decisions.get(dl);
  if (!decision) return line;
  cols[decisionIdx] = decision;
  auditChanged++;
  auditMisses.delete(dl);
  return writeCsvLine(cols);
});
if (auditMisses.size) {
  console.error(`Missing audit rows:'"\\n"'${Array.from(auditMisses).join('"'\\n')}"'`);
  process.exit(1);
}
fs.writeFileSync(AUDIT, nextAudit.join('"'\\n'));

let trackerChanged = 0;
let trackerMisses = new Set(decisions.keys());
const trackerLines = fs.readFileSync(TRACKER, 'utf8').split(/\\n/);
const trackerHeader = parseLine(trackerLines[0]);
const tPathIdx = trackerHeader.indexOf('pdf_path');
const tStatusIdx = trackerHeader.indexOf('status');
const tTickIdx = trackerHeader.indexOf('last_tick');
const tCiteIdx = trackerHeader.indexOf('cite_key');
const tNotesIdx = trackerHeader.indexOf('notes');
const nextTracker = trackerLines.map((line, idx) => {
  if (idx === 0 || "'!line.trim()) return line;
  const cols = parseLine(line);
  const p = cols[tPathIdx];
  const decision = decisions.get(p);
  if (!decision) return line;
  if (cols[tStatusIdx] === '"'claimed-by-codex' && cols[tNotesIdx] === SNAPSHOT_NOTE) {
    cols[tStatusIdx] = 'skipped-by-codex';
    cols[tTickIdx] = now;
    cols[tCiteIdx] = '';
    cols[tNotesIdx] = decision;
    trackerChanged++;
    trackerMisses.delete(p);
    return writeCsvLine(cols);
  }
  if (cols[tStatusIdx] === 'skipped-by-codex' && cols[tNotesIdx] === decision) {
    trackerMisses.delete(p);
  }
  return line;
});
if (trackerMisses.size) {
  console.error("'`Missing claimed tracker rows:'"\\n"'${Array.from(trackerMisses).join('"'\\n')}"'`);
  process.exit(1);
}
fs.writeFileSync(TRACKER, nextTracker.join('"'\\n'));

