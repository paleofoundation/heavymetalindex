const fs=require('fs'), path=require('path'), cp=require('child_process');
const snap=fs.readFileSync('/tmp/codex-snapshot-1780365507.txt','utf8').trim().split(/\\n/).filter(Boolean);
let i=0, active=0, done=0;
function runNext(){
  while(active<10 && i<snap.length){
    const rel=snap[i++]; active++;
    const out=path.join('/tmp/codex-auto-fetched-fulltext-1780365507', path.basename(rel)+'.txt');
    const p=cp.spawn('pdftotext',['-enc','UTF-8',rel,out],{stdio:'ignore'});
    p.on('close',()=>{active--; done++; runNext();});
    p.on('error',()=>{active--; done++; runNext();});
  }
  if(done===snap.length) console.log("'`extracted ${done}`);
}
runNext();
