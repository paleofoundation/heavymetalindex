const fs=require('fs');
function resolveAgent(path){
 const lines=fs.readFileSync(path,'utf8').split('\\n');
 const out=[]; let inConflict=false;
 for (const line of lines) {
   if (line.startsWith('<<<<<<< ')) { inConflict=true; continue; }
   if (line.startsWith('=======') && inConflict) continue;
   if (line.startsWith('>>>>>>> ') && inConflict) { inConflict=false; continue; }
   out.push(line);
 }
 fs.writeFileSync(path,out.join('\\n'));
}
function resolveTracker(path){
 const lines=fs.readFileSync(path,'utf8').split('\\n');
 const out=[]; let mode='normal';
 for (const line of lines) {
   if (line.startsWith('<<<<<<< ')) { mode='head'; continue; }
   if (line.startsWith('=======') && mode==='head') { mode='discard'; continue; }
   if (line.startsWith('>>>>>>> ') && mode==='discard') { mode='normal'; continue; }
   if (mode==='discard') continue;
   out.push(line);
 }
 fs.writeFileSync(path,out.join('\\n'));
}
resolveAgent('data/evidence/autonomy/agent-events.jsonl');
resolveTracker('data/evidence/autonomy/manual-fetch-tracker.csv');
NODE

