};
function splitCsvLine(line){
  const out=[]; let cur='', q=false;
  for (let i=0;i<line.length;i++) { const c=line[i]; if (c==='\"') { if (q && line[i+1]==='\"') {cur+='\"'; i++;} else q="'!q; } else if (c==='"','&&"'!q) { out.push(cur); cur='"''; } else cur+=c; }
  out.push(cur); return out;
}
function csv(vals){return vals.map(v=>/[\",\\n]/.test(String(v))?'\"'+String(v).replace(/\"/g,'\"\"')+'\"':String(v)).join(',')}
let lines=fs.readFileSync(trackerPath,'utf8').trimEnd().split('\\n');
lines=lines.map((line,i)=>{
 if(i===0) return line;
 const cols=splitCsvLine(line); const p=cols[0]; const r=rows[p];
 if("'!r) return line;
 cols[2]=r.status; cols[3]=ts; cols[4]=r.cite; cols[5]=r.note;
 return csv(cols);
});
fs.writeFileSync(trackerPath,lines.join('"'\\n')+'\\n');
let aud=fs.readFileSync(auditPath,'utf8').trimEnd().split('\\n');
aud=aud.map((line,i)=>{
 if(i===0) return line;
 const cols=splitCsvLine(line); const p=cols[3]; const r=rows[p];
 if("'!r) return line;
 cols[2]=r.audit;
 if(r.cite) cols[10]='"'true';
 return csv(cols);
});
fs.writeFileSync(auditPath,aud.join('\\n')+'\\n');
let ledger='';
for (const [p,r] of Object.entries(rows)) ledger += JSON.stringify({ts,actor:'codex',source_path:p,cite_key:r.cite,status:r.ledger,commit:'pending',blocker:r.blocker,next:r.next||'triage sweep'})+'\\n';
fs.appendFileSync(ledgerPath,ledger);
NODE

