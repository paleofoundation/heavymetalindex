codex
The tracker still has inherited embedded carriage returns in older note fields, and my CSV parse/write path normalized them. I’m replacing only the specific tracker lines from the HEAD blob now, byte-preserving every unrelated line.
exec
/bin/zsh -lc "node - <<'NODE'
const fs = require('fs');
const cp = require('child_process');
const file = 'data/evidence/autonomy/manual-fetch-tracker.csv';
const base = cp.execFileSync('git', ['show', "'`HEAD:${file}`]).toString('"'utf8');
function csv(v) {
  const s = String(v ?? '');
  return /[\",\\n\\r]/.test(s) ? "'`"${s.replaceAll('"'\"', '\"\"')}\""'` : s;
}
const updates = new Map();
function set(pdf_path, handle, status, last_tick, cite_key, notes) {
