function csv(s){s=String(s??'');return /[\",\\n]/.test(s)?'\"'+s.replace(/\"/g,'\"\"')+'\"':s;}
const decisions=new Map([
 ['raw/manual-fetch/seasonal-geographic-variance/auto-fetched/auto-baby-oil-cd-product_2024_10-3389-fnut-2024-1513864.pdf','skip:review-only-no-primary-data'],
 ['raw/manual-fetch/seasonal-geographic-variance/auto-fetched/auto-children-personal-care-pb-product_2016_10-1007-s11999-016-5100-0.pdf','skip:not-food-occurrence'],
]);
// Rewrite matching downloaded rows to skip decisions; append if no matching path exists.
let lines=fs.readFileSync(audit,'utf8').split(/\\r?\\n/).filter(Boolean);
const header=parse(lines[0]);
const idx=Object.fromEntries(header.map((h,i)=>[h,i]));
const seen=new Set();
const out=[lines[0]];
for(let i=1;i<lines.length;i++){
  const cells=parse(lines[i]);
  const p=cells[idx.downloaded_path]||'';
  if(decisions.has(p)){
    cells[idx.decision]=decisions.get(p);
    cells[idx.already_indexed]='false';
    seen.add(p);
    out.push(header.map((_,j)=>csv(cells[j]??'')).join(','));
  } else out.push(lines[i]);
}
for(const [p,decision] of decisions){
  if(seen.has(p)) continue;
  const filename=path.basename(p);
  const doi=filename.includes('10-3389')?'10.3389/fnut.2024.1513864':'10.1007/s11999-016-5100-0';
  const row={wishlist_id: filename.includes('baby-oil')?'AUTO-baby-oil-Cd-product':'AUTO-children-personal-care-Pb-product', wishlist_section: filename.includes('baby-oil')?'autonomy-product-personal-care':'autonomy-product-food', decision, downloaded_path:p, relevance_score:'', positive_score:'', negative_penalty:'', negative_hits:'', food_hits:'', domain_match:'', already_indexed:'false', title: filename.includes('baby-oil')?'Editorial: Novel chemical, microbiological and physical approaches in food safety control, volume II':'Your Best Life: Breaking the Cycle: The Power of Gratitude', doi, year: filename.includes('baby-oil')?'2024':'2016', journal: filename.includes('baby-oil')?'Frontiers in Nutrition':'Clinical Orthopaedics and Related Research', oa_url:'', cited_by_count:'', query_terms:''};
  out.push(header.map(h=>csv(row[h]??'')).join(','));
}
fs.writeFileSync(audit,out.join('\\n')+'\\n');
// Update our claim rows in tracker to skipped-by-codex.
lines=fs.readFileSync(tracker,'utf8').split(/\\r?\\n/).filter(Boolean);
const th=parse(lines[0]); const tidx=Object.fromEntries(th.map((h,i)=>[h,i]));
const now=new Date().toISOString();
const tout=[lines[0]];
for(let i=1;i<lines.length;i++){
  const cells=parse(lines[i]);
  const p=cells[tidx.pdf_path]||'';
  if(decisions.has(p) && (cells[tidx.status]||'')==='claimed-by-codex'){
    cells[tidx.status]='skipped-by-codex';
    cells[tidx.last_tick]=now;
    cells[tidx.notes]=decisions.get(p);
  }
  tout.push(th.map((_,j)=>csv(cells[j]??'')).join(','));
}
fs.writeFileSync(tracker,tout.join('\\n')+'\\n');
console.log('updated skip decisions:', [...decisions.values()].join(', '));
