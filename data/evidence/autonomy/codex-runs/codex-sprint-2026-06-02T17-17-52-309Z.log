const fs=require('fs');
const file='data/evidence/autonomy/manual-fetch-tracker.csv';
const snapPath=fs.readdirSync('/tmp').filter(f=>f.startsWith('codex-snapshot-')).map(f=>'/tmp/'+f).sort((a,b)=>fs.statSync(b).mtimeMs-fs.statSync(a).mtimeMs)[0];
const snap=fs.readFileSync(snapPath,'utf8').trim().split(/\\n/);
let lines=fs.readFileSync(file,'utf8').split(/\\n/);
const idx=new Map();
function firstField(line){ if(line.startsWith('\"')) return line.match(/"'^"([''^"]*)"/)?.[1]; return line.split('"',')[0]; }
function status(line){ if(line.startsWith('\"')) return line.match(/"'^"[''^"]*",[''^,]*,([''^,]*)/)?.[1]||'"''; return line.split(',')[2]||''; }
for(let i=1;i<lines.length;i++){ const p=firstField(lines[i]); if(p) idx.set(p.split('/').pop(), i); }
const picked=[];
for(const p of snap){ const i=idx.get(p.split('/').pop()); if(i==null) continue; const st=status(lines[i]); if(st.startsWith('claimed')||st.startsWith('ingested')) continue; picked.push(p); if(picked.length>=5) break; }
const ts=new Date().toISOString();
for(const p of picked){
  const i=idx.get(p.split('/').pop());
  const parts=lines[i].split(',');
  // The auto-fetched paths do not contain commas in this queue.
  parts[2]='claimed-by-codex';
  parts[3]=ts;
  parts[5]="'`Codex fire claim ${snapPath.split('"'/').pop()} (prior status: "'${status(lines[i])})`;
  lines[i]=parts.join('"',');
}
fs.writeFileSync(file, lines.join('\\n'));
console.log(picked.join('\\n'));
