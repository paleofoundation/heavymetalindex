  }))

if (newAuditRows.length) appendCsv(auditPath, auditHeader, newAuditRows)

const out = {
  snapshot: snapshot.length,
  processedUnclaimed: work.length,
  auditRowsAppended: newAuditRows.length,
  rollups: rollups.length,
