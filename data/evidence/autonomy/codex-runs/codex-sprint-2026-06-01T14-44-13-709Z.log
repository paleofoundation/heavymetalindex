function parseCsvLine(line) {
  const out = []
  let cur = ""
  let q = false
  for (let i = 0; i < line.length; i++) {
    const c = line[i]
    if (q && c === '"' && line[i + 1] === '"') { cur += '"'; i++; continue }
    if (c === '"') { q = !q; continue }
    if (c === "," && !q) { out.push(cur); cur = ""; continue }
    cur += c
  }
  out.push(cur)
  return out
}

