+authors: [Haji MS, Kombo MA, Mohamed AAJ]
+year: 2025
+publication: "Journal of Biomedical Research & Environmental Sciences 6(2): 197-203"
+doi: 10.37871/jbres2072
+source_type: peer-reviewed
+evidence_tier: A
+license: "CC BY 4.0"
+raw_path: raw/manual-fetch/seasonal-geographic-variance/auto-fetched/auto-whitening-products-cd-product_2025_10-37871-jbres2072.pdf
