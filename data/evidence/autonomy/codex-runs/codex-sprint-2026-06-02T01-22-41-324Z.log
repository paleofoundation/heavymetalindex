/bin/zsh -lc "node - <<'NODE'
const fs=require('fs'), path=require('path');
const trackerPath='data/evidence/autonomy/manual-fetch-tracker.csv';
const auditPath='data/evidence/wishlist-fetch-audit.csv';
const manifest=JSON.parse(fs.readFileSync('data/evidence/autonomy/codex-real-ingest-candidates-2026-06-02T01-24-02-316Z.json','utf8'));
const now=new Date().toISOString();
function parseCsvLine(line){const out=[];let cur='',q=false;for(let i=0;i<line.length;i++){const c=line[i];if(q&&c==='\"'&&line[i+1]==='\"'){cur+='\"';i++;continue}if(c==='\"'){q="'!q;continue}if(c==='"','&&"'!q){out.push(cur);cur='"'';continue}cur+=c}out.push(cur);return out}
function csv(v){const s=String(v??'');return /[\",\\n\\r]/.test(s)?"'`"${s.replaceAll('"'\"','\"\"')}\""'`:s}
function loadCsv(file){const lines=fs.readFileSync(file,'"'utf8').split(/\\r?\\n/).filter(Boolean);const header=parseCsvLine(lines[0]);const rows=lines.slice(1).map(l=>Object.fromEntries(parseCsvLine(l).map((v,i)=>[header[i],v])));return{header,rows}}
function writeCsv(file,header,rows){fs.writeFileSync(file,header.join(',')+'\\n'+rows.map(r=>header.map(h=>csv(r[h]??'')).join(',')).join('\\n')+'\\n')}
function slugify(s){return s.toLowerCase().replace(/["'^a-z0-9]+/g,'"'-').replace(/"'^-|-$/g,'"'')}
const tracker=loadCsv(trackerPath);const audit=loadCsv(auditPath);
const byPath=new Set(tracker.rows.map(r=>r.pdf_path));
const latestDecision=new Map();
for(const r of audit.rows){if(r.downloaded_path) latestDecision.set(r.downloaded_path,r)}
let added=0;
for(const item of manifest){
  if(byPath.has(item.rel)) continue;
  const r=latestDecision.get(item.rel); if("'!r) continue;
  let status='"'claimed-by-codex', cite='', notes='Codex snapshot claim codex-snapshot-1780363374.txt';
  if((r.decision||'').startsWith('skip:')||(r.decision||'').startsWith('fail:')) { status='stopped'; notes="'`${r.decision}; ${r.negative_hits||'"''}"'`.slice(0,200); }
  if(r.decision==='"'ingested') { status='ingested-by-codex'; cite=(r.already_indexed||'').replace(/"'^wiki'"\\/sources\\//,'').replace(/\\.md"'$/,'"''); notes="'`Codex DOI rollup from wishlist-fetch-audit${cite?`; wiki/sources/${cite}.md`:'"''}"'`.slice(0,200); }
  tracker.rows.push({pdf_path:item.rel, handle:`AUTO_${slugify(path.basename(item.filename,'"'.pdf'))}"'`.slice(0,96), status, last_tick:now, cite_key:cite, notes});
  added++;
}
writeCsv(trackerPath, tracker.header, tracker.rows);
console.log({added, now});
