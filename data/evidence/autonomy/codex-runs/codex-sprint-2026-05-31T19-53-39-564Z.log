// ---------- Tracker management ----------

function loadTracker() {
  if (!fs.existsSync(trackerPath) || rebuildTracker) {
    return new Map()
  }
  const lines = fs.readFileSync(trackerPath, "utf8").split("\n").filter(Boolean)
  const map = new Map()
