{
  "_comment": "v3 fidelity spec. Every value read from 'Heavy Metal Index v3.dc.html' at the cited line. Assertions run against COMPUTED styles in a rendered browser, not against source. px tolerance 1, color exact after rgb() normalization.",
  "viewport": { "width": 1440, "height": 1000 },

  "pages": {
    "/": [
      { "sel": "body", "prop": "background-color", "want": "#faf7f4", "src": "v3:35" },
      { "sel": ".hmi-home-hero h1", "prop": "font-size", "want": "58px", "src": "v3 HOME A" },
      { "sel": ".hmi-home-hero h1", "prop": "font-family", "want": "Lora", "match": "contains" },
      { "sel": ".hmi-home-search", "prop": "width", "want": "660px" },
      { "sel": ".hmi-home-search", "prop": "height", "want": "56px" },
      { "sel": ".hmi-home-search", "prop": "border-radius", "want": "3px", "note": "search.scss ships a 999px pill after custom.scss — if this fails, the pill won" },
      { "sel": ".hmi-metal-registry tbody tr", "prop": "count", "want": 8, "note": "eight metals; a missing row means a slug mismatch dropped it silently" }
    ],

    "/metals/lead": [
      { "sel": ".hero-band", "prop": "background-color", "want": "#8b2a4a", "src": "v3:363" },
      { "sel": ".hero-grid", "prop": "grid-template-columns", "want": "2-cols", "match": "colcount", "src": "v3:2011" },
      { "sel": ".hero-grid", "prop": "column-gap", "want": "72px", "src": "v3:2011" },
      { "sel": ".hero-grid", "prop": "padding-top", "want": "34px" },
      { "sel": ".hero-grid", "prop": "padding-left", "want": "48px" },
      { "sel": ".hero-title", "prop": "font-size", "want": "44px", "src": "v3:372" },
      { "sel": ".hero-title", "prop": "letter-spacing", "want": "-0.792px", "note": "-0.018em at 44px" },
      { "sel": ".hero-title", "prop": "font-family", "want": "Lora", "match": "contains" },
      { "sel": ".hero-kind", "prop": "font-size", "want": "11px" },
      { "sel": ".hero-kind", "prop": "text-transform", "want": "uppercase" },
      { "sel": ".hero-kind", "prop": "border-radius", "want": "2px" },
      { "sel": ".hero-act", "prop": "font-size", "want": "10.5px" },
      { "sel": ".hero-act", "prop": "border-radius", "want": "2px", "note": "if this reads 999px or 7px, the old .hero-pill rules are still live" },
      { "sel": ".hero-snapshot", "prop": "border-radius", "want": "0px", "note": "v3's snapshot is square; the old card was 12px" },
      { "sel": ".hero-glyph", "prop": "absent", "want": true, "note": "the 128px glyph circle must be GONE, not restyled" },
      { "sel": ".hero-pill", "prop": "absent", "want": true, "note": "old pills deleted from proof-design.scss" },
      { "sel": ".hero-right", "prop": "absent", "want": true, "note": "old RESEARCHED BY rail column" },

      { "sel": "header", "prop": "height", "want": "68px", "src": "v3:37" },
      { "sel": "header", "prop": "position", "want": "sticky" },
      { "sel": "header", "prop": "background-color", "want": "#fffdfb", "src": "v3:37" }
    ]
  },

  "narrow": {
    "viewport": { "width": 1024, "height": 900 },
    "page": "/metals/lead",
    "assert": [
      { "sel": ".hero-grid", "prop": "grid-template-columns", "want": "1-col", "match": "colcount", "note": "v3 collapses below 1150, it does not shrink" },
      { "sel": "[data-wide-only]", "prop": "hidden", "want": true, "note": "v3 REMOVES chrome below 1150 rather than scaling it" }
    ]
  }
}
