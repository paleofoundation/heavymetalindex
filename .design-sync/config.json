{
  "pkg": "hmi-design-system",
  "globalName": "HMIDesignSystem",
  "shape": "package",
  "projectId": "c70d039a-eeb6-422a-8ed8-890116b16564",
  "buildCmd": "cd .design-sync/hmi-ds && node build-css.mjs && npx tsc -p tsconfig.json",
  "cssEntry": "styles/hmi-v3.css",
  "runtimeFontPrefixes": ["Lora", "Inter", "IBM Plex Mono"],
  "readmeHeader": ".design-sync/conventions.md",
  "overrides": {
    "TopNav": { "cardMode": "single", "viewport": "1360x120" },
    "HeroBand": { "cardMode": "column" },
    "Footer": { "cardMode": "column" },
    "ProductEvidenceSummary": { "cardMode": "column" },
    "Corrections": { "cardMode": "column" },
    "RelatedPages": { "cardMode": "column" },
    "GridOfRecords": { "cardMode": "column", "viewport": "1024x680" },
    "DataTable": { "cardMode": "column" }
  }
}
